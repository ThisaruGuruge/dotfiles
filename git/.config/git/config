# Git Configuration
# Personal settings (name, email) are in ~/.gitconfig.local (not tracked)

[include]
    path = ~/.gitconfig.local

# Identity by directory (gitdir: is case-sensitive, so keep these lowercase).
# Work email for everything under ~/projects/work/
[includeIf "gitdir:~/projects/work/"]
    path = ~/.config/git/work.gitconfig

# Personal email for ~/projects/leisure/ and ~/projects/personal/
[includeIf "gitdir:~/projects/leisure/"]
    path = ~/.config/git/personal.gitconfig

[includeIf "gitdir:~/projects/personal/"]
    path = ~/.config/git/personal.gitconfig

[init]
    defaultBranch = dev

[status]
    branch = true
    showStash = true
    short = true

[diff]
    context = 3
    renames = copies
    interHunkContext = 10
    colorMoved = default

[core]
    whitespace = trailing-space,space-before-tab
    preloadindex = true
    untrackedCache = true
    fsmonitor = true
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    hyperlinks = true

[merge]
    conflictstyle = zdiff3

[pull]
    rebase = true

[fetch]
    prune = true

[push]
    default = current
    autoSetupRemote = true

[rebase]
    autoStash = true

[rerere]
    enabled = true

[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = -version:refname

[log]
    date = short

[pretty]
    custom = %C(red)%h%C(reset) -%C(yellow)%d%C(reset) %s %C(green)(%cd) %C(bold blue)<%an>%C(reset)

[color "status"]
    added = green
    changed = yellow
    untracked = red
    branch = magenta bold
    header = white dim

[color "branch"]
    current = magenta bold
    local = yellow
    remote = green

[alias]
    unstage = reset HEAD --
    undo = reset --soft HEAD~1
    cleanup = !git for-each-ref --merged HEAD --format='%(refname:short)' refs/heads | grep -vxE 'main|master|dev|develop' | grep -vxF \"$(git branch --show-current)\" | xargs -n 1 git branch -d

[commit]
    gpgSign = true

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers

[advice]
    addEmptyPathSpec = false
    pushFastForward = false
    statusHints = false

# Org shortcuts (e.g. `git clone me:repo`) are machine-local: define them in
# ~/.gitconfig.local (see git/.gitconfig.local.example).
[url "git@github.com:"]
    insteadOf = "gh:"
