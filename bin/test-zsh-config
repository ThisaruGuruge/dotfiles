#!/bin/zsh

# Test script for zsh configuration
# Validates that all tools and environment are working correctly after zshrc changes

# Color codes for beautiful output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

# Unicode symbols
CHECK="✓"
CROSS="✗"
ARROW="→"
STAR="★"
INFO="ℹ"
WARN="⚠"

# Test counters
PASSED=0
FAILED=0
WARNINGS=0

# Get dotfiles directory
DOTFILES_DIR="${HOME}/dotfiles"
if [ ! -d "$DOTFILES_DIR" ]; then
    DOTFILES_DIR="${HOME}/.dotfiles"
fi

# Print section header
print_header() {
    echo ""
    echo -e "${BOLD}${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${BOLD}${CYAN}${STAR} $1${RESET}"
    echo -e "${BOLD}${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
}

# Print test result
print_test() {
    local name="$1"
    local test_status="$2"
    local details="$3"

    if [[ "$test_status" == "pass" ]]; then
        echo -e "${GREEN}  ${CHECK} ${name}${RESET}"
        [[ -n "$details" ]] && echo -e "    ${CYAN}${ARROW} ${details}${RESET}"
        ((PASSED++))
    elif [[ "$test_status" == "fail" ]]; then
        echo -e "${RED}  ${CROSS} ${name}${RESET}"
        [[ -n "$details" ]] && echo -e "    ${RED}${ARROW} ${details}${RESET}"
        ((FAILED++))
    elif [[ "$test_status" == "warn" ]]; then
        echo -e "${YELLOW}  ${WARN} ${name}${RESET}"
        [[ -n "$details" ]] && echo -e "    ${YELLOW}${ARROW} ${details}${RESET}"
        ((WARNINGS++))
    else
        echo -e "    ${INFO} ${name}: ${details}"
    fi
}

# Test a command and version
test_tool() {
    local tool_name="$1"
    local command="$2"
    local version_cmd="$3"
    local optional="${4:-false}"

    if command -v "$command" >/dev/null 2>&1; then
        local version
        version=$(eval "$version_cmd" 2>&1 | head -n 1)
        print_test "$tool_name" "pass" "$version"
        return 0
    else
        if [[ "$optional" == "true" ]]; then
            print_test "$tool_name" "warn" "Not installed (optional)"
        else
            print_test "$tool_name" "fail" "Command not found"
        fi
        return 1
    fi
}

# Test environment variable
test_env_var() {
    local var_name="$1"
    local var_value="${(P)var_name}"

    if [[ -n "$var_value" ]]; then
        print_test "$var_name" "pass" "$var_value"
        return 0
    else
        print_test "$var_name" "warn" "Not set"
        return 1
    fi
}

# Start tests
clear
echo -e "${BOLD}${MAGENTA}"
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║                                                              ║"
echo "║           ZSH Configuration Validation Suite                 ║"
echo "║                                                              ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo -e "${RESET}"
echo -e "${CYAN}Testing dotfiles configuration and tool availability...${RESET}"
echo -e "${CYAN}Date: $(date '+%Y-%m-%d %H:%M:%S')${RESET}"

# ============================================================================
# SHELL ENVIRONMENT
# ============================================================================
print_header "Shell Environment"

echo -e "${CYAN}  Shell: ${RESET}$SHELL"
echo -e "${CYAN}  ZSH Version: ${RESET}$ZSH_VERSION"
echo -e "${CYAN}  Terminal: ${RESET}${TERM_PROGRAM:-$TERM}"

if [[ -f ~/.zshrc ]]; then
    local zshrc_path
    zshrc_path=$(readlink ~/.zshrc 2>/dev/null || echo ~/.zshrc)
    print_test "ZSHRC Location" "pass" "$zshrc_path"
else
    print_test "ZSHRC Location" "fail" "~/.zshrc not found"
fi

# ============================================================================
# CORE ENVIRONMENT VARIABLES
# ============================================================================
print_header "Environment Variables"

test_env_var "HOME"
test_env_var "PATH"
test_env_var "NVM_DIR"
test_env_var "SDKMAN_DIR"
test_env_var "JAVA_HOME"

# ============================================================================
# CORE PACKAGES (from Brewfile)
# ============================================================================
print_header "Core Packages"

test_tool "Go" "go" "go version"
test_tool "bestow" "bestow" "bestow --version"
test_tool "fzf" "fzf" "fzf --version"
test_tool "zoxide" "zoxide" "zoxide --version"
test_tool "bat" "bat" "bat --version | head -1"
test_tool "eza" "eza" "eza --version | head -1"
test_tool "dust" "dust" "dust --version"
test_tool "uv" "uv" "uv --version"
test_tool "ripgrep" "rg" "rg --version | head -1"
test_tool "fd" "fd" "fd --version"
test_tool "git-delta" "delta" "delta --version"
test_tool "lazygit" "lazygit" "lazygit --version | head -1"
test_tool "tmux" "tmux" "tmux -V"
test_tool "htop" "htop" "htop --version | head -1"
test_tool "direnv" "direnv" "direnv --version"
test_tool "atuin" "atuin" "atuin --version"
test_tool "gh" "gh" "gh --version | head -1"
test_tool "gwsp" "gwsp" "gwsp --version | head -1"
test_tool "gwse" "gwse" "gwse --version | head -1"

# Bare gws must stay blocked so nothing touches a Google account without context
if gws --version >/dev/null 2>&1; then
    print_test "gws guard" "fail" "Bare gws ran; bin/gws should refuse it (is ~/bin before Homebrew on PATH?)"
else
    print_test "gws guard" "pass" "Bare gws is blocked (use gwsp/gwse)"
fi
test_tool "jq" "jq" "jq --version"
test_tool "jless" "jless" "jless --version" "true"
test_tool "mdcat" "mdcat" "mdcat --version"
test_tool "yazi" "yazi" "yazi --version"
test_tool "chafa" "chafa" "chafa --version | head -1"
test_tool "lazydocker" "lazydocker" "lazydocker --version | head -1" "true"

# ============================================================================
# SECURITY TOOLS
# ============================================================================
print_header "Security Tools"

test_tool "sops" "sops" "sops --version"
test_tool "age" "age" "age --version"

if [[ -f "$HOME/.config/sops/age/keys.txt" ]]; then
    print_test "Age Keys" "pass" "Found at $HOME/.config/sops/age/keys.txt"
else
    print_test "Age Keys" "warn" "Not found (required for encrypted secrets)"
fi

# ============================================================================
# BREWFILE (declared packages are installed)
# ============================================================================
print_header "Brewfile"

BREWFILE_PATH="${0:A:h:h}/Brewfile"
if ! command -v brew >/dev/null 2>&1; then
    print_test "brew bundle" "warn" "Homebrew not installed; skipping Brewfile check"
elif [[ ! -f "$BREWFILE_PATH" ]]; then
    print_test "brew bundle" "warn" "Brewfile not found at $BREWFILE_PATH"
# Read-only and offline: without these, `brew bundle` auto-updates first (network, writes to the Homebrew repo)
elif HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ANALYTICS=1 HOMEBREW_NO_ENV_HINTS=1 HOMEBREW_NO_INSTALL_CLEANUP=1 \
    brew bundle check --no-upgrade --file="$BREWFILE_PATH" >/dev/null 2>&1; then
    print_test "brew bundle" "pass" "All Brewfile entries are installed"
else
    print_test "brew bundle" "warn" "Missing Brewfile entries (run: brew bundle --file=$BREWFILE_PATH; list them with: brew bundle check --verbose --file=$BREWFILE_PATH; ballerina is listed in Brewfile but may be a direct install)"
fi

# ============================================================================
# SPECIAL INSTALLATIONS
# ============================================================================
print_header "Special Installations"

if [[ -d "$HOME/.sdkman" ]]; then
    print_test "SDKMAN" "pass" "Installed at $HOME/.sdkman"
else
    print_test "SDKMAN" "warn" "Not found (optional)"
fi

if [[ -d "${HOME}/.local/share/zinit/zinit.git" ]]; then
    print_test "Zinit Plugin Manager" "pass" "Installed"
else
    print_test "Zinit Plugin Manager" "warn" "Not found"
fi

# ============================================================================
# PROGRAMMING LANGUAGES & RUNTIMES (Manual checks for installed tools)
# ============================================================================
print_header "Programming Languages & Runtimes"

# Java
test_tool "Java" "java" "java -version 2>&1 | head -n 1"

# Node.js (via NVM)
test_tool "Node.js" "node" "node --version"

# NPM
test_tool "NPM" "npm" "npm --version"

# Ballerina
test_tool "Ballerina" "bal" "bal version 2>&1 | head -n 1"

# Python (optional)
test_tool "Python" "python3" "python3 --version" "true"

# Ruby (optional)
test_tool "Ruby" "ruby" "ruby --version" "true"

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================
print_header "Development Tools"

# Claude Code (critical for this workflow!)
test_tool "Claude Code" "claude" "claude --version"

# mdcat (markdown renderer)
test_tool "mdcat" "mdcat" "mdcat --version"

# Yazi (terminal file manager)
test_tool "Yazi" "yazi" "yazi --version"
test_tool "chafa" "chafa" "chafa --version | head -1"

# Git
test_tool "Git" "git" "git --version"

# Docker (optional)
test_tool "Docker" "docker" "docker --version" "true"

# Colima (optional container runtime)
test_tool "colima" "colima" "colima --version" "true"

# docker-credential-osxkeychain (optional; stores registry creds in macOS Keychain)
test_tool "docker-credential-osxkeychain" "docker-credential-osxkeychain" "docker-credential-osxkeychain list" "true"

# Gradle (gng provides gw command that finds gradlew anywhere in the project tree)
if command -v gw >/dev/null 2>&1; then
    print_test "GNG (gw)" "pass" "Gradle run-anywhere wrapper available"
elif command -v gradle >/dev/null 2>&1; then
    test_tool "Gradle" "gradle" "gradle --version | head -n 3 | tail -n 1" "true"
else
    print_test "Gradle/GNG" "warn" "Neither gw nor gradle found (optional)"
fi

# Maven (optional)
if command -v mvn >/dev/null 2>&1; then
    test_tool "Maven" "mvn" "mvn --version | head -n 1" "true"
fi

# ============================================================================
# SHELL PLUGINS & FEATURES
# ============================================================================
print_header "Shell Plugins & Features"

# Note: Functions and aliases are loaded in the parent shell but not visible in test subshell
echo -e "${CYAN}  Custom Functions & Aliases: ${RESET}Loaded in parent shell (not testable in subshell)"

# Check for plugin manager installations instead
if [[ -d "${HOME}/.local/share/zinit/zinit.git" ]]; then
    print_test "Zinit Plugin Manager" "pass" "Installed"
else
    print_test "Zinit Plugin Manager" "warn" "Not found"
fi

# Test Powerlevel10k prompt configuration
local p10k_config="$HOME/.p10k.zsh"
if [[ -f "$p10k_config" ]] || [[ -L "$p10k_config" ]]; then
    # Validate syntax without sourcing (safe in subshell)
    if zsh -n "$p10k_config" 2>/dev/null; then
        print_test "Powerlevel10k Config" "pass" "~/.p10k.zsh syntax OK"
    else
        print_test "Powerlevel10k Config" "fail" "Syntax errors in ~/.p10k.zsh"
    fi
    local p10k_real
    p10k_real=$(readlink "$p10k_config" 2>/dev/null || echo "$p10k_config")
    print_test "Powerlevel10k Location" "pass" "Config at $p10k_real"
else
    print_test "Powerlevel10k Config" "fail" "~/.p10k.zsh not found"
fi

# Check p10k plugin installed via zinit
local zinit_p10k="${HOME}/.local/share/zinit/plugins/romkatv---powerlevel10k"
if [[ -d "$zinit_p10k" ]]; then
    print_test "Powerlevel10k Plugin" "pass" "Installed via zinit"
else
    print_test "Powerlevel10k Plugin" "warn" "Not found at $zinit_p10k"
fi

# ============================================================================
# SHELL CORE (self-contained: exercises the repo files, not the live shell)
# ============================================================================
print_header "Shell Core (repo files)"

# ${0:A:h:h} resolves symlinks, so this works from ~/bin, a worktree or a clone.
local sc_repo="${0:A:h:h}"
local sc_tmp
sc_tmp="$(mktemp -d "${TMPDIR:-/tmp}/zsh-core-test.XXXXXX")"
local sc_prelude='source "$R/zsh/.aliases.sh"; for f in "$R"/zsh/.functions.d/*.zsh; do source "$f"; done'

# sc_check <name> <detail-on-failure> <command...>: pass when the command succeeds.
sc_check() {
    local name="$1" detail="$2"
    shift 2
    if "$@" >/dev/null 2>&1; then
        print_test "$name" "pass" ""
    else
        print_test "$name" "fail" "$detail"
    fi
}

# --- cp / mv are tty-guarded functions ---------------------------------------
local sc_out
sc_out="$(R=$sc_repo zsh -f -c "$sc_prelude"'; print -r -- "$(whence -w cp) | $(whence -w mv) | $(whence -w lg)"; alias . >/dev/null 2>&1 && print "dot-alias-present"' 2>&1)"
if [[ "$sc_out" == "cp: function | mv: function | lg: function" ]]; then
    print_test "cp, mv, lg are functions (no -riv/-iv aliases, no '.' alias)" "pass" ""
else
    print_test "cp, mv, lg are functions (no -riv/-iv aliases, no '.' alias)" "fail" "$sc_out"
fi

(
    cd "$sc_tmp" || exit 1
    mkdir -p cpmv/d && : >cpmv/d/x && print new >cpmv/a && print old >cpmv/b
    R=$sc_repo zsh -f -c "$sc_prelude"'; cd cpmv && mv a b && cp -R d e' </dev/null
    [[ "$(<cpmv/b)" == new && ! -e cpmv/a && -f cpmv/e/x ]]
) >/dev/null 2>&1
if [[ $? -eq 0 ]]; then
    print_test "mv overwrites and cp -R copies with no terminal attached" "pass" ""
else
    print_test "mv overwrites and cp -R copies with no terminal attached" "fail" "alias-style -i/-r flags are back?"
fi

# --- confirm never exits the shell --------------------------------------------
if command -v script >/dev/null 2>&1; then
    local sc_inner="$sc_tmp/confirm-inner.zsh"
    {
        print -r -- 'for f in 00-colors 01-core; do source "$R/zsh/.functions.d/$f.zsh"; done'
        print -r -- 'confirm "go?"'
        print -r -- 'print "RC=$? ALIVE"'
    } >"$sc_inner"
    local sc_key sc_rc_ok=true
    for sc_key in y:0 n:1 q:2; do
        sc_out="$( (sleep 0.5; printf '%s' "${sc_key%%:*}") | R=$sc_repo script -q /dev/null zsh -f "$sc_inner" 2>&1 | tr -d '\r')"
        [[ "$sc_out" == *"RC=${sc_key##*:} ALIVE"* ]] || sc_rc_ok=false
    done
    if $sc_rc_ok; then
        print_test "confirm: y=0, n=1, q=2 and the shell stays alive" "pass" ""
    else
        print_test "confirm: y=0, n=1, q=2 and the shell stays alive" "fail" "last output: $sc_out"
    fi
else
    print_test "confirm return codes" "warn" "script(1) not available"
fi

# --- kill_by_port only touches the listener -----------------------------------
if command -v python3 >/dev/null 2>&1 && command -v lsof >/dev/null 2>&1; then
    local sc_port=$((20000 + RANDOM % 20000)) sc_srv="" sc_cli="" sc_i
    # Started detached (not children of this script), so a killed listener is
    # reaped at once instead of lingering as a zombie that `kill -0` still sees.
    # Each writes its PID once it is listening / connected.
    (python3 -I -c "
import os, socket, time
s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind(('127.0.0.1', $sc_port)); s.listen(5)
open('$sc_tmp/kbp.srv', 'w').write(str(os.getpid()))
c, _ = s.accept(); time.sleep(120)" >/dev/null 2>&1 &)
    for sc_i in {1..100}; do [[ -s "$sc_tmp/kbp.srv" ]] && break; sleep 0.05; done
    (python3 -I -c "
import os, socket, time
c = socket.create_connection(('127.0.0.1', $sc_port))
open('$sc_tmp/kbp.cli', 'w').write(str(os.getpid())); time.sleep(120)" >/dev/null 2>&1 &)
    for sc_i in {1..100}; do [[ -s "$sc_tmp/kbp.cli" ]] && break; sleep 0.05; done
    sc_srv="$(cat "$sc_tmp/kbp.srv" 2>/dev/null)" sc_cli="$(cat "$sc_tmp/kbp.cli" 2>/dev/null)"
    R=$sc_repo zsh -f -c "$sc_prelude; kill_by_port $sc_port" >/dev/null 2>&1
    if [[ "$sc_srv" == <-> && "$sc_cli" == <-> ]] && ! kill -0 "$sc_srv" 2>/dev/null && kill -0 "$sc_cli" 2>/dev/null; then
        print_test "kill_by_port stops the listener and leaves the client alone" "pass" ""
    else
        print_test "kill_by_port stops the listener and leaves the client alone" "fail" "listener alive: $(kill -0 "$sc_srv" 2>/dev/null && echo yes || echo no), client alive: $(kill -0 "$sc_cli" 2>/dev/null && echo yes || echo no)"
    fi
    [[ "$sc_srv" == <-> ]] && kill "$sc_srv" 2>/dev/null
    [[ "$sc_cli" == <-> ]] && kill "$sc_cli" 2>/dev/null
else
    print_test "kill_by_port listener-only" "warn" "python3 or lsof not available"
fi
sc_out="$(R=$sc_repo zsh -f -c "$sc_prelude"'; kill_by_port 1 2 >/dev/null && print accepted-two-ports; kill_by_port -h | grep -q "TCP only" || print no-tcp-note' 2>&1)"
if [[ -z "$sc_out" ]]; then
    print_test "kill_by_port: refuses two ports; help says TCP only" "pass" ""
else
    print_test "kill_by_port: refuses two ports; help says TCP only" "fail" "$sc_out"
fi

# --- compress / extract -------------------------------------------------------
(
    cd "$sc_tmp" || exit 1
    mkdir -p arch/proj && print hi >arch/proj/f && cd arch || exit 1
    R=$sc_repo zsh -f -c "$sc_prelude"'
        compress proj/ >/dev/null 2>&1 || exit 11
        [[ -f proj.tar.gz && ! -e .tar.gz ]] || exit 12
        compress >/dev/null 2>&1 && exit 13
        extract >/dev/null 2>&1 && exit 14
        extract nothing.tar.gz >/dev/null 2>&1 && exit 15
        rm -r proj && extract proj.tar.gz >/dev/null 2>&1 || exit 16
        [[ "$(<proj/f)" == hi ]] || exit 17
        extract proj.tar.gz proj.tar.gz >/dev/null 2>&1; true' </dev/null
)
sc_out=$?
if [[ $sc_out -eq 0 ]]; then
    print_test "compress/extract: trailing slash, usage errors, round trip" "pass" ""
else
    print_test "compress/extract: trailing slash, usage errors, round trip" "fail" "step exit code $sc_out"
fi

# --- awake (stubbed pmset / caffeinate / osascript) ----------------------------
# The caffeinate stub logs its flags and PID, then execs a symlink to sleep that
# is named caffeinate, so `ps -o comm=` reports caffeinate like the real one.
local sc_stub="$sc_tmp/stub"
mkdir -p "$sc_stub/real" "$sc_tmp/awake"
ln -s /bin/sleep "$sc_stub/real/caffeinate"
printf '%s\n' '#!/bin/sh' 'echo "$@" >> "$AWAKE_TEST_LOG"' 'echo $$ >> "$AWAKE_TEST_PIDS"' 'exec "${0%/*}/real/caffeinate" 3607' >"$sc_stub/caffeinate"
printf '%s\n' '#!/bin/sh' 'cat "$AWAKE_TEST_BATT"' >"$sc_stub/pmset"
printf '%s\n' '#!/bin/sh' 'echo "$@" >> "$AWAKE_TEST_NOTIFY"' >"$sc_stub/osascript"
chmod +x "$sc_stub/caffeinate" "$sc_stub/pmset" "$sc_stub/osascript"
: >"$sc_tmp/awake/pids"
printf "Now drawing from 'AC Power'\n -InternalBattery-0 (id=1)\t90%%; charging; 0:30 remaining present: true\n" >"$sc_tmp/awake/batt"
cat >"$sc_tmp/awake/run.zsh" <<'AWAKE_EOF'
source "$R/zsh/.functions.d/05-system.zsh"
batt() { printf "Now drawing from 'Battery Power'\n -InternalBattery-0 (id=1)\t%s%%; discharging; 3:00 remaining present: true\n" "$1" >"$AWAKE_TEST_BATT"; }
last() { tail -1 "$AWAKE_TEST_LOG"; }
live() { local n=0 p; for p in $(<"$AWAKE_TEST_PIDS"); do _awake_alive "$p" && ((n++)); done; print $n; }
until_ok() { local i; for i in {1..60}; do eval "$1" && return 0; sleep 0.05; done; return 1; }
pf="$TMPDIR/dotfiles-awake.pid"
awake >/dev/null || exit 20
[[ "$(last)" == "-i" ]] || { echo "default flags: $(last)"; exit 21; }
pid=$(<"$pf")
awake | grep -q 'already active' || exit 22
[[ "$(<"$pf")" == "$pid" ]] || exit 23
awake status | grep -q 'awake: active' || exit 24
awake ac >/dev/null
[[ "$(last)" == "-s" ]] || { echo "ac flags: $(last)"; exit 25; }
awake status | grep -q 'AC-only hold drops if unplugged' || exit 251
awake screen >/dev/null
[[ "$(last)" == "-i -d" ]] || { echo "screen flags: $(last)"; exit 26; }
awake for 2h >/dev/null
[[ "$(last)" == "-i -t 7200" ]] || { echo "for flags: $(last)"; exit 27; }
awake for nonsense >/dev/null 2>&1 && exit 28
awake for 0 >/dev/null 2>&1 && exit 281
awake for 1 >/dev/null 2>&1 && exit 282
[[ "$(live)" == 1 ]] || { echo "live holds after replacing: $(live)"; exit 283; }
awake stop >/dev/null
[[ ! -e "$pf" ]] || exit 29
# stale state naming an unrelated process as the watcher: it is left alone
sleep 30 &
other=$!
print 99999 >"$pf"
print "watcher=$other" >"${pf%.pid}.state"
awake stop >/dev/null
kill -0 "$other" 2>/dev/null || exit 291
kill "$other"
# a process that merely mentions caffeinate in its arguments is not a hold
zsh -f -c 'zmodload zsh/zselect; zselect -t 3000' x caffeinate.md &
other=$!
_awake_alive "$other" && exit 292
kill "$other"
# function-only shell snapshot (no global variables survive): still works
typeset -f >"$TMPDIR/snap.zsh"
zsh -f -c 'source "$TMPDIR/snap.zsh"; awake >/dev/null && [[ -f "$TMPDIR/dotfiles-awake.pid" ]] && awake stop >/dev/null' || exit 293
# three shells starting at once leave exactly one hold
awake >/dev/null &
awake screen >/dev/null &
awake ac >/dev/null &
wait
[[ "$(live)" == 1 ]] || { echo "live holds after concurrent starts: $(live)"; exit 294; }
awake stop >/dev/null
# battery watcher: above the floor keeps the hold, at the floor releases + notifies
batt 50
awake --floor 20 >/dev/null
pid=$(<"$pf")
sleep 0.4
_awake_alive "$pid" || exit 31
batt 20
until_ok '! _awake_alive "$pid"' || exit 32
until_ok 'grep -q "released the awake hold" "$AWAKE_TEST_NOTIFY"' || exit 33
until_ok '[[ ! -e "$pf" ]]' || exit 34
# below the floor: refuse to start; a refused replacement keeps the current hold
batt 15
awake >/dev/null 2>&1 && exit 35
awake --floor 10 >/dev/null || exit 36
pid=$(<"$pf")
awake screen >/dev/null 2>&1 && exit 37
_awake_alive "$pid" || exit 38
awake stop >/dev/null
# the pidfile cannot be written: the start fails and no hold is left behind
mkdir "$pf"
awake >/dev/null 2>&1 && exit 39
rmdir "$pf"
until_ok '[[ "$(live)" == 0 ]]' || exit 40
exit 0
AWAKE_EOF
(
    export PATH="$sc_stub:$PATH" TMPDIR="$sc_tmp/awake" AWAKE_POLL_SECS=0.2 R="$sc_repo"
    export AWAKE_TEST_LOG="$sc_tmp/awake/log" AWAKE_TEST_PIDS="$sc_tmp/awake/pids" AWAKE_TEST_BATT="$sc_tmp/awake/batt" AWAKE_TEST_NOTIFY="$sc_tmp/awake/notify"
    zsh -f "$sc_tmp/awake/run.zsh" </dev/null
    rc=$?
    # never leave a hold or watcher behind, whatever happened
    zsh -f -c 'source "$R/zsh/.functions.d/05-system.zsh"; awake stop' >/dev/null 2>&1
    exit $rc
) >"$sc_tmp/awake/out" 2>&1
sc_out=$?
# Clean up only what this test started: stub holds by recorded PID (and only
# while they are still the stub), watchers by their marker plus this test's
# private pidfile path.
local sc_hp="" sc_line=""
for sc_hp in $(<"$sc_tmp/awake/pids"); do
    [[ "$(ps -p "$sc_hp" -o args= 2>/dev/null)" == "$sc_stub/real/caffeinate"* ]] && kill "$sc_hp" 2>/dev/null
done
for sc_line in "${(@f)$(ps -axww -o pid=,args= 2>/dev/null)}"; do
    [[ "$sc_line" == *" dotfiles-awake-watch "*" $sc_tmp/awake/dotfiles-awake.pid "* ]] && kill "${${=sc_line}[1]}" 2>/dev/null
done
if [[ $sc_out -eq 0 ]]; then
    print_test "awake: flags, idempotent start, stop, lock, stale state, battery floor" "pass" ""
else
    print_test "awake: flags, idempotent start, stop, lock, stale state, battery floor" "fail" "exit $sc_out: $(head -c 300 "$sc_tmp/awake/out")"
fi

# --- tool-init cache: failed init is never cached; success is header-keyed ----
mkdir -p "$sc_tmp/cache/bin" "$sc_tmp/cache/home"
printf '%s\n' '#!/bin/sh' 'echo run >> "$CACHE_COUNT"' 'echo "FAKE_INIT=1"' >"$sc_tmp/cache/bin/faketool"
printf '%s\n' '#!/bin/sh' 'exit 1' >"$sc_tmp/cache/bin/badtool"
chmod +x "$sc_tmp/cache/bin"/*
sed -n '/^_cache_tool_init() {/,/^}/p' "$sc_repo/zsh/.zshrc.d/05-shell-integrations.zsh" >"$sc_tmp/cache/fn.zsh"
(
    export HOME="$sc_tmp/cache/home" PATH="$sc_tmp/cache/bin:$PATH" CACHE_COUNT="$sc_tmp/cache/count"
    zsh -f -c '
        source "$HOME/../fn.zsh"
        _cache_tool_init badtool "badtool"
        [[ ! -s "$HOME/.cache/zsh/badtool_init.zsh" ]] || exit 41
        _cache_tool_init faketool "faketool"
        _cache_tool_init faketool "faketool"
        [[ "$FAKE_INIT" == 1 ]] || exit 42
        [[ "$(wc -l <"$CACHE_COUNT" | tr -d " ")" == 1 ]] || exit 43
        [[ "$(head -1 "$HOME/.cache/zsh/faketool_init.zsh")" == "# tool-path: "* ]] || exit 44
        exit 0' </dev/null
)
sc_out=$?
if [[ $sc_out -eq 0 ]]; then
    print_test "init cache: failed init not cached, good init cached once" "pass" ""
else
    print_test "init cache: failed init not cached, good init cached once" "fail" "exit $sc_out"
fi

# --- login shell: no ~/.local/bin/env, nvm default first, XDG from .zshenv ----
local sc_home="$sc_tmp/loginhome"
mkdir -p "$sc_home/.nvm/alias" "$sc_home/.nvm/versions/node/v22.2.0/bin" "$sc_home/.nvm/versions/node/v22.22.2/bin"
print 22.2 >"$sc_home/.nvm/alias/default"
ln -sf "$sc_repo/zsh/.zshenv" "$sc_home/.zshenv"
ln -sf "$sc_repo/zsh/.zprofile" "$sc_home/.zprofile"
ln -sf "$sc_repo/bash/.profile" "$sc_home/.profile"
sc_out="$(env -i HOME="$sc_home" PATH=/usr/bin:/bin zsh -l -c 'print -r -- "${path[1]}|$XDG_CONFIG_HOME|$XDG_CACHE_HOME"' 2>&1)"
sc_rc=$?
if [[ $sc_rc -eq 0 ]]; then
    print_test "login zsh exits 0 without ~/.local/bin/env" "pass" ""
else
    print_test "login zsh exits 0 without ~/.local/bin/env" "fail" "rc=$sc_rc: $sc_out"
fi
if [[ "$sc_out" == "$sc_home/.nvm/versions/node/v22.2.0/bin|$sc_home/.config|$sc_home/Library/Caches" ]]; then
    print_test "login zsh: nvm default (anchored version) first on PATH; XDG_* from .zshenv" "pass" ""
else
    print_test "login zsh: nvm default (anchored version) first on PATH; XDG_* from .zshenv" "fail" "$sc_out"
fi

# nvm default forms: exact versions resolve with no NOMATCH noise; alias names
# that are not versions (node, system) or a missing alias file change nothing.
mkdir -p "$sc_home/.nvm/alias/lts" "$sc_home/.nvm/versions/node/v22.10.0/bin"
print lts/jod >"$sc_home/.nvm/alias/lts/*"
print v22.10.0 >"$sc_home/.nvm/alias/lts/jod"
local sc_nvm_bad="" sc_case sc_def sc_want
for sc_case in "22=v22.22.2" "22.2=v22.2.0" "22.2.0=v22.2.0" "v22.2.0=v22.2.0" "lts/*=v22.10.0" "node=" "system=" "MISSING="; do
    sc_def="${sc_case%%=*}"
    sc_want="${sc_case#*=}"
    if [[ "$sc_def" == MISSING ]]; then
        rm -f "$sc_home/.nvm/alias/default"
    else
        print -r -- "$sc_def" >"$sc_home/.nvm/alias/default"
    fi
    # One line of output (no error text): the nvm bin first, or else no nvm
    # entry and no stray /bin promoted to the front.
    sc_out="$(env -i HOME="$sc_home" PATH=/usr/bin:/bin zsh -l -c 'print -r -- "${path[1]}"; print -rl -- $path | grep -c "/.nvm/"' 2>&1)"
    if [[ -n "$sc_want" ]]; then
        [[ "$sc_out" == "$sc_home/.nvm/versions/node/$sc_want/bin"$'\n'1 ]] || sc_nvm_bad+=" [$sc_def] ${sc_out//$sc_home/~}"
    else
        [[ "$sc_out" == *$'\n'0 && "${sc_out%%$'\n'*}" != /bin && "$sc_out" != *$'\n'*$'\n'* ]] || sc_nvm_bad+=" [$sc_def] ${sc_out//$sc_home/~}"
    fi
done
print 22.2 >"$sc_home/.nvm/alias/default"
if [[ -z "$sc_nvm_bad" ]]; then
    print_test "nvm default: 22, 22.2, 22.2.0, v22.2.0, lts/*, node, system, missing (no errors, no bogus PATH)" "pass" ""
else
    print_test "nvm default: 22, 22.2, 22.2.0, v22.2.0, lts/*, node, system, missing (no errors, no bogus PATH)" "fail" "$sc_nvm_bad"
fi

# --- global gitignore ---------------------------------------------------------
if command -v git >/dev/null 2>&1; then
    mkdir -p "$sc_tmp/ig" && git -C "$sc_tmp/ig" init -q 2>/dev/null
    local sc_ign="$sc_repo/git/.config/git/ignore" sc_bad="" sc_p
    for sc_p in gradle/wrapper/gradle-wrapper.jar sub/gradle/wrapper/gradle-wrapper.jar Cargo.lock vendor/github.com/x/y.go; do
        git -C "$sc_tmp/ig" -c core.excludesFile="$sc_ign" check-ignore -q "$sc_p" && sc_bad+=" ignored:$sc_p"
    done
    for sc_p in lib/other.jar node_modules/x .env vendor/bundle/x.rb; do
        git -C "$sc_tmp/ig" -c core.excludesFile="$sc_ign" check-ignore -q "$sc_p" || sc_bad+=" not-ignored:$sc_p"
    done
    if [[ -z "$sc_bad" ]]; then
        print_test "global gitignore keeps wrapper jar, Cargo.lock, vendor/ and still ignores jars/.env" "pass" ""
    else
        print_test "global gitignore keeps wrapper jar, Cargo.lock, vendor/ and still ignores jars/.env" "fail" "$sc_bad"
    fi
fi

# --- completions --------------------------------------------------------------
local sc_missing="" sc_c
for sc_c in _extract _kill_by_port _awake _reload _edit_commands; do
    if [[ ! -f "$sc_repo/zsh/completions/$sc_c" ]] || ! head -1 "$sc_repo/zsh/completions/$sc_c" | grep -q '^#compdef ' || ! zsh -n "$sc_repo/zsh/completions/$sc_c" 2>/dev/null; then
        sc_missing+=" $sc_c"
    fi
    grep -q "\`$sc_c\`" "$sc_repo/zsh/completions/README.md" || sc_missing+=" README:$sc_c"
done
grep -q 'completions' "$sc_repo/zsh/.zshrc.d/02-completion.zsh" || sc_missing+=" fpath-entry"
if [[ -z "$sc_missing" ]]; then
    print_test "completions: files valid, listed in README, ~/completions on fpath" "pass" ""
else
    print_test "completions: files valid, listed in README, ~/completions on fpath" "fail" "$sc_missing"
fi

# --- names documented anywhere must exist; removed names must be gone --------
local -a sc_documented=(lg glog gca gundo awake kill_by_port extract compress show_tools alias_help alias_docs alias_search brew-sync brew-check)
(( $+commands[fd] )) && sc_documented+=(f fdg fdh fda)
(( $+commands[rg] )) && sc_documented+=(g rgh rga)
(( $+commands[dust] )) && sc_documented+=(d)
sc_out="$(R=$sc_repo zsh -f -c "$sc_prelude"'; for n in "$@"; do whence -w "$n" | grep -Eq ": (alias|function)$" || print -n "$n "; done' _ "${sc_documented[@]}" 2>&1)"
if [[ -z "$sc_out" ]]; then
    print_test "every alias/function named in the docs exists (whence)" "pass" ""
else
    print_test "every alias/function named in the docs exists (whence)" "fail" "missing: $sc_out"
fi
sc_out="$(R=$sc_repo zsh -f -c "$sc_prelude"'; for n in dont_sleep stay_awake stay_awake_stop stay_awake_for brew-sync-optional brew-check-optional remove_dotfiles_tool adopt-config; do whence -w "$n" | grep -Eq ": (alias|function)$" && print -n "$n "; done' 2>&1)"
if [[ -z "$sc_out" ]]; then
    print_test "removed aliases/functions are gone" "pass" ""
else
    print_test "removed aliases/functions are gone" "fail" "still defined: $sc_out"
fi
if ! grep -Eq '(^|`)(fg|fh|fa|gh) ' "$sc_repo/docs/SEARCH_CHEATSHEET.md" && ! grep -Eq 'gamend|Option\+H' "$sc_repo/zsh/.functions.d/07-docs.zsh"; then
    print_test "docs use real alias names (no fg/fh/fa/gh, gamend, Option+H)" "pass" ""
else
    print_test "docs use real alias names (no fg/fh/fa/gh, gamend, Option+H)" "fail" "stale names in docs/SEARCH_CHEATSHEET.md or 07-docs.zsh"
fi

# --- config details -----------------------------------------------------------
sc_check "bin/sync-brewfile is read-only (no dump / --force)" "script rewrites a Brewfile" \
    bash -c '! grep -v "^[[:space:]]*#" "$1" | grep -Eq "bundle dump|--force"' _ "$sc_repo/bin/sync-brewfile"
sc_check "atuin: global filter, invert, full style, tabs; failed commands not suppressed" "unexpected atuin settings" \
    bash -c 'f="$1"; grep -q "^filter_mode = \"global\"" "$f" && grep -q "^invert = true" "$f" && grep -q "^style = \"full\"" "$f" && grep -q "^show_tabs = true" "$f" && grep -q "filters = \[ \"global\", \"workspace\"" "$f" && ! grep -Eq "^store_failed" "$f"' _ "$sc_repo/atuin/.config/atuin/config.toml"
sc_check "fzf Ctrl-T / Alt-C previews configured" "FZF_CTRL_T_OPTS / FZF_ALT_C_OPTS missing" \
    bash -c 'grep -q "^export FZF_CTRL_T_OPTS" "$1" && grep -q "^export FZF_ALT_C_OPTS" "$1" && ! grep -q "^export FZF_DEFAULT_OPTS" "$1"' _ "$sc_repo/zsh/.zshrc.d/05-shell-integrations.zsh"

rm -rf "$sc_tmp"
unfunction sc_check 2>/dev/null

# ============================================================================
# ENVIRONMENT FILES
# ============================================================================
print_header "Configuration Files"

if [[ -f "$HOME/.env" ]]; then
    print_test "Environment File" "pass" "Found at $HOME/.env"
else
    print_test "Environment File" "warn" "Not found at $HOME/.env"
fi

# ============================================================================
# SECRETS HYGIENE (file names and modes only; never prints contents)
# ============================================================================
print_header "Secrets Hygiene"

# sops writes a sops_mac= line into every encrypted dotenv file
_is_sops_encrypted() { [[ -f "$1" ]] && grep -q -e '^sops_mac=' -- "$1" 2>/dev/null }

if [[ -f "$HOME/.env" ]]; then
    if _is_sops_encrypted "$HOME/.env"; then
        print_test "~/.env encrypted" "pass" "sops-encrypted"
    else
        print_test "~/.env encrypted" "warn" "Plaintext; run edit_secrets to encrypt it"
    fi
fi

# Nothing reads zsh/.env; a copy there is one `git add -f` from a public repo
if [[ -e "$DOTFILES_DIR/zsh/.env" ]]; then
    print_test "No zsh/.env in the repo" "warn" "$DOTFILES_DIR/zsh/.env exists; secrets belong in ~/.env (edit_secrets) - delete it"
else
    print_test "No zsh/.env in the repo" "pass" ""
fi

local -a plaintext_backups=()
local backup_file
for backup_file in "$HOME"/.env.backup*(N); do
    _is_sops_encrypted "$backup_file" || plaintext_backups+=("${backup_file:t}")
done
if (( ${#plaintext_backups} )); then
    print_test "~/.env backups encrypted" "warn" "Plaintext: ${(j:, :)plaintext_backups} - delete them (and rotate what they hold)"
else
    print_test "~/.env backups encrypted" "pass" ""
fi

local env_cache="$HOME/.cache/zsh/env_cache.v2"
if [[ -e "$env_cache" ]]; then
    local cache_mode cache_dir_mode
    cache_mode=$(stat -f %Lp "$env_cache")
    cache_dir_mode=$(stat -f %Lp "$HOME/.cache/zsh")
    if [[ "$cache_mode" == 600 && "$cache_dir_mode" == 700 ]]; then
        print_test "Decrypted env cache private" "pass" "File 600, directory 700"
    else
        print_test "Decrypted env cache private" "warn" "File $cache_mode, directory $cache_dir_mode (want 600/700); the shell ignores it and decrypts again"
    fi
fi
# The pre-v2 cache could be a readable copy of the ciphertext; any new shell
# deletes it
if [[ -e "$HOME/.cache/zsh/env_cache" || -L "$HOME/.cache/zsh/env_cache" ]]; then
    print_test "No old env cache" "warn" "~/.cache/zsh/env_cache is left from the old loader; open a new shell (or rm it)"
fi

# ~/.sops.yaml is per machine: a file listing this machine's age key
local age_public_key
age_public_key=$(age-keygen -y "$HOME/.config/sops/age/keys.txt" 2>/dev/null | head -n 1)
if [[ -L "$HOME/.sops.yaml" && ! -e "$HOME/.sops.yaml" ]]; then
    print_test "~/.sops.yaml" "warn" "Dangling symlink (to $(readlink "$HOME/.sops.yaml")); fix: rm ~/.sops.yaml && ./init.sh"
elif [[ -f "$HOME/.sops.yaml" ]]; then
    local sops_where="File"
    [[ -L "$HOME/.sops.yaml" ]] && sops_where="Symlink to ${${:-$HOME/.sops.yaml}:A}"
    if [[ -n "$age_public_key" ]] && grep -qF -- "$age_public_key" "$HOME/.sops.yaml"; then
        print_test "~/.sops.yaml" "pass" "$sops_where lists this machine's age key"
    else
        print_test "~/.sops.yaml" "warn" "$sops_where doesn't list this machine's age key; new secrets would be unreadable here"
    fi
else
    print_test "~/.sops.yaml" "warn" "Missing; edit_secrets encrypts to this machine's key, ./init.sh writes the file"
fi

# ============================================================================
# TOUCH ID FOR SUDO
# ============================================================================
print_header "Touch ID for sudo"

if [[ -f /etc/pam.d/sudo_local ]] && grep -Eq '^[[:space:]]*auth[[:space:]].*pam_tid\.so' /etc/pam.d/sudo_local 2>/dev/null; then
    print_test "Touch ID for sudo" "pass" "Enabled via /etc/pam.d/sudo_local"

    local reattach_lib
    reattach_lib=$(awk '$1 == "auth" && $3 ~ /pam_reattach\.so$/ { print $3; exit }' /etc/pam.d/sudo_local 2>/dev/null)
    if [[ -n "$reattach_lib" ]]; then
        print_test "Touch ID in tmux (pam_reattach)" "pass" "Configured ($reattach_lib)"

        # sudo loads the module as root, so it must be a real file, and it and
        # every directory above it must be root-owned and not writable by
        # group/others: whoever can write any of them can swap the module (a
        # copy in the user-writable Homebrew prefix is a local root escalation)
        local reattach_problem="" reattach_path reattach_owner reattach_mode
        if [[ ! -e "$reattach_lib" ]]; then
            reattach_problem="$reattach_lib is missing"
        elif [[ -L "$reattach_lib" ]]; then
            reattach_problem="$reattach_lib is a symlink (to $(readlink "$reattach_lib"))"
        else
            reattach_path=${reattach_lib:A}
            while :; do
                reattach_owner=$(stat -f %Su "$reattach_path")
                reattach_mode=$(stat -f %Lp "$reattach_path")
                if [[ "$reattach_owner" != root ]]; then
                    reattach_problem="$reattach_path is owned by $reattach_owner, not root"
                    break
                elif (( 8#$reattach_mode & 8#022 )); then
                    reattach_problem="$reattach_path is writable by group/others (mode $reattach_mode)"
                    break
                fi
                [[ "$reattach_path" == / ]] && break
                reattach_path=${reattach_path:h}
            done
        fi
        if [[ -z "$reattach_problem" ]]; then
            print_test "pam_reattach ownership" "pass" "Root-owned (file and every parent directory), not writable by others"
        else
            print_test "pam_reattach ownership" "fail" "$reattach_problem; run ./init.sh (Touch ID step) to move it to /opt/pam"
        fi
    else
        print_test "Touch ID in tmux (pam_reattach)" "warn" "Not configured (Touch ID won't work in tmux)"
    fi
else
    print_test "Touch ID for sudo" "warn" "Not enabled (run init.sh to configure)"
fi

# ============================================================================
# PATH VALIDATION
# ============================================================================
print_header "PATH Validation"

# Check for common important paths
local important_paths=(
    "${HOMEBREW_PREFIX:-/opt/homebrew}/bin"
    "/usr/local/bin"
    "$HOME/.local/bin"
)

for path_item in "${important_paths[@]}"; do
    if [[ ":$PATH:" == *":$path_item:"* ]]; then
        print_test "PATH contains $path_item" "pass" ""
    else
        print_test "PATH contains $path_item" "warn" "Not in PATH"
    fi
done

# Check for NVM path if NVM is loaded
if [[ -n "$NVM_DIR" ]] && [[ -d "$NVM_DIR/versions/node" ]]; then
    # Check if any node version bin is in PATH
    if echo "$PATH" | grep -q "$NVM_DIR/versions/node"; then
        local node_version=$(echo "$PATH" | grep -o "$NVM_DIR/versions/node/[^:]*" | head -1 | xargs basename 2>/dev/null)
        print_test "NVM Node in PATH" "pass" "$node_version"
    else
        print_test "NVM Node in PATH" "warn" "Node bin directory not found in PATH"
    fi
fi

# Check for duplicate PATH entries
local path_array=("${(@s/:/)PATH}")
local unique_paths=("${(@u)path_array}")
if [[ ${#path_array[@]} -eq ${#unique_paths[@]} ]]; then
    print_test "PATH Deduplication" "pass" "No duplicate entries"
else
    local duplicate_count=$((${#path_array[@]} - ${#unique_paths[@]}))
    print_test "PATH Deduplication" "warn" "$duplicate_count duplicate entries found"
fi

# ============================================================================
# TMUX CONFIGURATION
# ============================================================================
print_header "Tmux Configuration"

# Checked against the repo this script lives in, so it also works from a worktree
local tmux_repo="${0:A:h:h}"
local tmux_conf="$tmux_repo/tmux/.tmux.conf"
local tmux_palette="$tmux_repo/tmux/.local/bin/tmux-palette-entries"
local ghostty_conf="$tmux_repo/ghostty/.config/ghostty/config"

if [[ -f "$tmux_conf" ]]; then
    # Ghostty's Cmd shortcuts send the literal tmux prefix (Ctrl+a = \x01)
    if grep -qE '^set(-option)? +-g +prefix +C-a[[:space:]]*$' "$tmux_conf"; then
        print_test "Tmux prefix is C-a" "pass" "Matches the Ghostty keybinds that send it"
    elif [[ -f "$ghostty_conf" ]] && grep -q 'text:\\x01' "$ghostty_conf"; then
        print_test "Tmux prefix is C-a" "fail" "Ghostty keybinds send the C-a byte but the tmux prefix changed; update both"
    else
        print_test "Tmux prefix is C-a" "warn" "Prefix is not C-a"
    fi

    # Every prefix-table bind in tmux.conf must have a row in the command palette
    if [[ -f "$tmux_palette" ]]; then
        local -a palette_keys conf_keys missing_keys
        local tm_line tm_field tm_tok tm_key tm_table tm_skip
        local -a tm_words
        while IFS= read -r tm_line; do
            [[ "$tm_line" == \#* || -z "${tm_line// /}" ]] && continue
            tm_field="${${(s:|:)tm_line}[2]}"
            tm_field="${tm_field//\{pipe\}/|}"
            [[ "$tm_field" =~ 'prefix \+ (.*[^[:space:]])[[:space:]]*$' ]] || continue
            palette_keys+=(${(s:/:)match[1]})
        done < "$tmux_palette"

        while IFS= read -r tm_line; do
            [[ "$tm_line" =~ '^[[:space:]]*bind(-key)?[[:space:]]' ]] || continue
            tm_words=(${(z)tm_line})
            shift tm_words
            tm_table="prefix"
            tm_skip=0
            tm_key=""
            while (( $#tm_words )); do
                tm_tok="${(Q)tm_words[1]}"
                shift tm_words
                case "$tm_tok" in
                    -n) tm_skip=1 ;;
                    -T) tm_table="${(Q)tm_words[1]}"; shift tm_words ;;
                    -N) shift tm_words ;;
                    -) tm_key="-"; break ;;
                    -*) ;;
                    *) tm_key="$tm_tok"; break ;;
                esac
            done
            [[ $tm_skip -eq 1 || "$tm_table" != "prefix" || -z "$tm_key" ]] && continue
            conf_keys+=("$tm_key")
        done < "$tmux_conf"

        for tm_key in "${conf_keys[@]}"; do
            (( ${palette_keys[(Ie)$tm_key]} )) || missing_keys+=("$tm_key")
        done
        if (( ${#missing_keys[@]} == 0 )); then
            print_test "Tmux palette covers every prefix binding" "pass" "${#conf_keys[@]} bindings checked"
        else
            print_test "Tmux palette covers every prefix binding" "warn" "Missing from tmux-palette-entries: ${(j:, :)missing_keys}"
        fi

        # Every palette command must parse as tmux config (isolated throwaway server)
        if command -v tmux &>/dev/null; then
            local tm_sock="dotfiles-palette-check-$$" tm_bad=() tm_cmd tm_tmp tm_sockpath
            tm_tmp="$(mktemp "${TMPDIR:-/tmp}/palette-check.XXXXXX")"
            if env -u TMUX tmux -L "$tm_sock" -f /dev/null new-session -d -s palettecheck 2>/dev/null; then
                while IFS= read -r tm_line; do
                    [[ "$tm_line" == \#* || -z "${tm_line// /}" ]] && continue
                    tm_cmd="$(awk -F'|' '{c=$4; for(i=5;i<=NF;i++) c=c "|" $i; print c}' <<< "$tm_line" | sed 's/^ *//;s/ *$//')"
                    [[ -z "$tm_cmd" || "$tm_cmd" == "noop" ]] && continue
                    print -r -- "$tm_cmd" > "$tm_tmp"
                    env -u TMUX tmux -L "$tm_sock" source-file -n "$tm_tmp" &>/dev/null || tm_bad+=("$tm_cmd")
                done < "$tmux_palette"
                # kill-server leaves the socket file behind (tmux 3.7): remove it too
                tm_sockpath="$(env -u TMUX tmux -L "$tm_sock" display-message -p '#{socket_path}' 2>/dev/null)"
                env -u TMUX tmux -L "$tm_sock" kill-server &>/dev/null
                [[ -n "$tm_sockpath" && "${tm_sockpath:t}" == "$tm_sock" ]] && rm -f "$tm_sockpath"
                if (( ${#tm_bad[@]} == 0 )); then
                    print_test "Tmux palette commands parse" "pass" ""
                else
                    print_test "Tmux palette commands parse" "fail" "Unparseable: ${tm_bad[1]}"
                fi
            fi
            rm -f "$tm_tmp"
        fi
    else
        print_test "Tmux palette entries" "fail" "$tmux_palette not found"
    fi

    # Helper scripts the config calls must exist and be executable
    local -a tm_missing_exec
    local tm_script
    for tm_script in \
        "$tmux_repo/tmux/.local/bin/tmux-palette" \
        "$tmux_repo/tmux/.local/bin/tmux-session-layout" \
        "$tmux_repo/tmux/.local/bin/tmux-sessionizer" \
        "$tmux_repo/tmux/.local/bin/tmux-session-creator" \
        "$tmux_repo/tmux/.local/bin/tmux-session-switcher" \
        "$tmux_repo/tmux/.local/bin/tmux-claude-next" \
        "$tmux_repo/bin/tmux-status-sysinfo" \
        "$tmux_repo/bin/tmux-status-battery" \
        "$tmux_repo/bin/tmux-status-claude"; do
        [[ -x "$tm_script" ]] || tm_missing_exec+=("${tm_script#$tmux_repo/}")
    done
    if (( ${#tm_missing_exec[@]} == 0 )); then
        print_test "Tmux helper scripts executable" "pass" ""
    else
        print_test "Tmux helper scripts executable" "fail" "Not executable or missing: ${(j:, :)tm_missing_exec}"
    fi
else
    print_test "Tmux config" "warn" "$tmux_conf not found"
fi

# ============================================================================
# CLAUDE CODE (status line, tmux state hook, tracked settings)
# ============================================================================
print_header "Claude Code"

# The checks live in tests/claude/check.sh (bash, runs in a temp HOME); this only reports them.
# ${0:A:h:h} is the repo holding this script, so a worktree tests its own files.
while IFS='|' read -r claude_status claude_name claude_detail; do
    case "$claude_status" in
        PASS) print_test "$claude_name" "pass" "$claude_detail" ;;
        FAIL) print_test "$claude_name" "fail" "$claude_detail" ;;
        WARN) print_test "$claude_name" "warn" "$claude_detail" ;;
    esac
done < <(bash "${0:A:h:h}/tests/claude/check.sh" "${0:A:h:h}" 2>&1)

# ============================================================================
# PERFORMANCE CHECKS
# ============================================================================
print_header "Performance Checks"

# Test shell startup time (approximation)
echo -e "${CYAN}  ${INFO} Measuring shell startup time (3 samples)...${RESET}"
local total_time=0
for i in {1..3}; do
    local start=$(date +%s%N)
    zsh -i -c exit >/dev/null 2>&1
    local end=$(date +%s%N)
    local elapsed=$(( (end - start) / 1000000 )) # Convert to milliseconds
    total_time=$((total_time + elapsed))
done
local avg_time=$((total_time / 3))
local startup_seconds=$(awk "BEGIN {printf \"%.2f\", $avg_time/1000}")

if [[ $avg_time -lt 500 ]]; then
    print_test "Shell Startup Time" "pass" "${startup_seconds}s (Excellent - instant)"
elif [[ $avg_time -lt 1000 ]]; then
    print_test "Shell Startup Time" "pass" "${startup_seconds}s (Good - very responsive)"
elif [[ $avg_time -lt 2000 ]]; then
    print_test "Shell Startup Time" "warn" "${startup_seconds}s (Acceptable - could be faster)"
else
    print_test "Shell Startup Time" "warn" "${startup_seconds}s (Slow - consider optimization)"
fi

# ============================================================================
# DOTDOCTOR, PR HELPERS, ENVRC
# ============================================================================
print_header "Dotdoctor, PR Helpers, envrc"

dotdoctor_bin="$DOTFILES_DIR/bin/dotdoctor"
if [[ ! -f "$dotdoctor_bin" ]]; then
    print_test "dotdoctor" "fail" "bin/dotdoctor not found"
elif [[ ! -x "$dotdoctor_bin" ]]; then
    print_test "dotdoctor" "fail" "bin/dotdoctor is not executable (chmod +x)"
elif ! bash -n "$dotdoctor_bin" 2>/dev/null; then
    print_test "dotdoctor" "fail" "bin/dotdoctor has a bash syntax error"
elif ! "$dotdoctor_bin" --help >/dev/null 2>&1; then
    print_test "dotdoctor" "fail" "dotdoctor --help did not exit 0"
else
    print_test "dotdoctor" "pass" "present, executable, parses, --help exits 0"
fi

for fn_def in "prs:04-git.zsh" "prw:04-git.zsh" "envrc:02-navigation.zsh"; do
    fn_name="${fn_def%%:*}"
    fn_file="$DOTFILES_DIR/zsh/.functions.d/${fn_def##*:}"
    if grep -q "^${fn_name}()" "$fn_file" 2>/dev/null; then
        print_test "function ${fn_name}" "pass" "defined in ${fn_def##*:}"
    else
        print_test "function ${fn_name}" "fail" "not defined in ${fn_def##*:}"
    fi
done
unset dotdoctor_bin fn_def fn_name fn_file

# Behavioural tests (scratch HOME, fake gh/fzf/claude; never touches your setup)
shell_helpers_test="$DOTFILES_DIR/bin/test-shell-helpers"
if [[ ! -x "$shell_helpers_test" ]]; then
    print_test "shell helper behaviour tests" "fail" "bin/test-shell-helpers missing or not executable"
elif ! command -v zsh >/dev/null 2>&1; then
    print_test "shell helper behaviour tests" "warn" "zsh not found; skipped"
elif shell_helpers_out="$("$shell_helpers_test" 2>&1)"; then
    print_test "shell helper behaviour tests" "pass" "$(printf '%s\n' "$shell_helpers_out" | tail -n 1)"
else
    print_test "shell helper behaviour tests" "fail" "$(printf '%s\n' "$shell_helpers_out" | grep -m3 'FAIL' | tr '\n' ';')"
fi
unset shell_helpers_test shell_helpers_out

# ============================================================================
# SUMMARY
# ============================================================================
echo ""
echo -e "${BOLD}${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${BOLD}${MAGENTA}Test Summary${RESET}"
echo -e "${BOLD}${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""

local total_tests=$((PASSED + FAILED + WARNINGS))
local pass_rate=0
if [[ $total_tests -gt 0 ]]; then
    pass_rate=$(( (PASSED * 100) / total_tests ))
fi

echo -e "  ${GREEN}${CHECK} Passed:   ${BOLD}${PASSED}${RESET}"
echo -e "  ${RED}${CROSS} Failed:   ${BOLD}${FAILED}${RESET}"
echo -e "  ${YELLOW}${WARN} Warnings: ${BOLD}${WARNINGS}${RESET}"
echo -e "  ${CYAN}━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "  ${BOLD}Total:    ${total_tests}${RESET}"
echo -e "  ${BOLD}Pass Rate: ${pass_rate}%${RESET}"
echo ""

echo ""

# Overall status
if [[ $FAILED -eq 0 ]]; then
    if [[ $WARNINGS -eq 0 ]]; then
        echo -e "${BOLD}${GREEN}╔════════════════════════════════════════╗${RESET}"
        echo -e "${BOLD}${GREEN}║  ${CHECK} ALL TESTS PASSED - EXCELLENT! ${CHECK}  ║${RESET}"
        echo -e "${BOLD}${GREEN}╚════════════════════════════════════════╝${RESET}"
        exit 0
    else
        echo -e "${BOLD}${YELLOW}╔═══════════════════════════════════════════════╗${RESET}"
        echo -e "${BOLD}${YELLOW}║  ${WARN} TESTS PASSED WITH WARNINGS           ║${RESET}"
        echo -e "${BOLD}${YELLOW}║    Review warnings for potential issues      ║${RESET}"
        echo -e "${BOLD}${YELLOW}╚═══════════════════════════════════════════════╝${RESET}"
        exit 0
    fi
else
    echo -e "${BOLD}${RED}╔═══════════════════════════════════════════════╗${RESET}"
    echo -e "${BOLD}${RED}║  ${CROSS} TESTS FAILED - ACTION REQUIRED        ║${RESET}"
    echo -e "${BOLD}${RED}║    Review failed tests above                 ║${RESET}"
    echo -e "${BOLD}${RED}╚═══════════════════════════════════════════════╝${RESET}"
    exit 1
fi
