#!/bin/bash
# Single lint entry point for the dotfiles repo (also run by CI).
#
#   bin/lint            run every check; missing tools are skipped locally
#   CI=true bin/lint    missing tools are failures (claude is always optional)
#                       (only the exact value "true" counts as CI)
#   bin/lint --file F   lint one file with the checks below that apply to it
#                       (by the same lists); prints only problems, each with
#                       a `fix:` line, exits 1 on any. Silent and 0 for a file
#                       no check covers; missing tools are skipped silently.
#                       Used by the claude-mods/conventions mod after edits.
#
# Checks:
#   1. shellcheck + `shfmt -i 4 -ci -d` on an explicit list of bash scripts
#   2. `zsh -n` on zsh modules and zsh-shebang scripts
#   3. `stylua --check nvim/.config/nvim` (stylua skips hidden dirs, so the
#      path must point inside nvim/.config)
#   4. `claude plugin test` for each mod with hooks/ in claude-mods/ (local
#      only: skipped without `claude`, which CI does not install). The vendored
#      rabe mod (~25 s of a ~30 s run) is skipped unless it differs from the
#      merge base with origin/dev or origin/main, or LINT_VENDORED=1 is set.
#
# Every non-README file in bin/ must be listed below (by shebang), so a new
# script cannot silently escape linting.
#
# zsh files are never fed to shellcheck/shfmt (neither parses zsh).

set -u

usage() {
    printf 'usage: bin/lint [--file <path>]\n' >&2
    exit 2
}

# --file: resolve the path against the caller's directory before cd-ing to the repo.
FILE=""
case $# in
    0) ;;
    2)
        [ "$1" = "--file" ] || usage
        if [ ! -f "$2" ]; then
            printf 'lint: no such file: %s\n' "$2" >&2
            exit 2
        fi
        FILE="$(cd -P "$(dirname -- "$2")" && pwd)/$(basename -- "$2")"
        ;;
    *) usage ;;
esac

# Resolve symlinks (bin/ is stowed per file into ~/bin) before locating the repo.
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
    LINK="$(readlink "$SRC")"
    case "$LINK" in
        /*) SRC="$LINK" ;;
        *) SRC="$(dirname "$SRC")/$LINK" ;;
    esac
done
REPO="$(cd -P "$(dirname "$SRC")/.." && pwd)"
cd "$REPO" || exit 1

FAILED=0
SKIPPED=0

step() { printf '\n==> %s\n' "$1"; }
fail() {
    printf '  FAIL  %s\n' "$1"
    FAILED=$((FAILED + 1))
}
ok() { printf '  ok    %s\n' "$1"; }

# Missing tool: failure in CI (unless optional), skip locally.
need() {
    if command -v "$1" >/dev/null 2>&1; then
        return 0
    fi
    if [ "${CI:-}" = true ] && [ "${2:-}" != "optional" ]; then
        fail "$1 not installed"
    else
        printf '  skip  %s not installed\n' "$1"
        SKIPPED=$((SKIPPED + 1))
    fi
    return 1
}

# Bash scripts (explicit list: bin/ also holds zsh scripts and README.md).
BASH_FILES=(
    init.sh
    zsh/.paths.sh
    bin/adopt-config
    bin/audit-configs
    bin/gws
    bin/gws-account
    bin/gwse
    bin/gwsp
    bin/lint
    bin/profile-startup
    bin/reset-dotfiles
    bin/sync-brewfile
    bin/claude-statusline
    bin/claude-tmux-state
    bin/tmux-status-claude
    bin/dotdoctor
    claude/.claude-enterprise/statusline-command.sh
    claude/.claude-personal/statusline-command.sh
)

# zsh files: modules plus zsh-shebang scripts.
ZSH_FILES=(
    zsh/.zshrc
    zsh/.zshenv
    zsh/.zprofile
    zsh/.functions.sh
    zsh/.aliases.sh
    zsh/.functions.d/*.zsh
    zsh/.zshrc.d/*.zsh
    bin/profile-zsh-startup
    bin/test-shell-helpers
    bin/test-zsh-config
    bin/tmux-status-battery
    bin/tmux-status-sysinfo
)

in_list() {
    local x=$1 g
    shift
    for g in "$@"; do
        [ "$g" = "$x" ] && return 0
    done
    return 1
}

# Runs one tool on the file; on failure prints its output and the fix line.
file_check() {
    local fix=$1 out
    shift
    command -v "$1" >/dev/null 2>&1 || return 0
    if ! out=$("$@" 2>&1); then
        printf '%s\n' "$out"
        printf 'fix: %s\n' "$fix"
        return 1
    fi
}

# bin/lint --file: the checks the full run would apply to this one file.
lint_file() {
    local f=$1 status=0
    if in_list "$f" "${BASH_FILES[@]}"; then
        # One line per finding (gcc format) keeps the report short
        file_check "address the shellcheck findings in $f" shellcheck -f gcc -e SC1091,SC2039 "$f" || status=1
        file_check "shfmt -i 4 -ci -w $f" shfmt -i 4 -ci -d "$f" || status=1
    elif in_list "$f" "${ZSH_FILES[@]}"; then
        file_check "fix the zsh syntax error in $f" zsh -n "$f" || status=1
    fi
    case "$f" in
        nvim/.config/nvim/*.lua)
            file_check "stylua $f" stylua --check "$f" || status=1
            ;;
        bin/README.md) ;;
        bin/[!/.]*/*) ;;
        bin/[!/.]*)
            if ! in_list "$f" "${BASH_FILES[@]}" "${ZSH_FILES[@]}"; then
                printf '%s is not in BASH_FILES or ZSH_FILES in bin/lint\n' "$f"
                printf 'fix: add it to BASH_FILES (bash) or ZSH_FILES (zsh) in bin/lint\n'
                status=1
            fi
            ;;
    esac
    return "$status"
}

if [ -n "$FILE" ]; then
    case "$FILE" in
        "$REPO"/*) lint_file "${FILE#"$REPO"/}" ;;
        *) exit 0 ;;
    esac
    exit
fi

step "bin/ coverage (every script is listed)"
unlisted=0
for f in bin/*; do
    case "$f" in bin/README.md) continue ;; esac
    [ -f "$f" ] || continue
    listed=0
    for g in "${BASH_FILES[@]}" "${ZSH_FILES[@]}"; do
        [ "$g" = "$f" ] && listed=1 && break
    done
    if [ "$listed" -eq 0 ]; then
        fail "$f is not in BASH_FILES or ZSH_FILES in bin/lint"
        unlisted=1
    fi
done
[ "$unlisted" -eq 0 ] && ok "all bin/ scripts listed"

step "listed files exist"
missing=0
for f in "${BASH_FILES[@]}" "${ZSH_FILES[@]}"; do
    if [ ! -f "$f" ]; then
        fail "listed file missing: $f"
        missing=1
    fi
done
[ "$missing" -eq 0 ] && ok "all listed files exist"

step "shellcheck (bash scripts)"
if need shellcheck; then
    if shellcheck -e SC1091,SC2039 "${BASH_FILES[@]}"; then
        ok "${#BASH_FILES[@]} files"
    else
        fail "shellcheck reported issues"
    fi
fi

step "shfmt -i 4 -ci -d (bash scripts)"
if need shfmt; then
    if shfmt -i 4 -ci -d "${BASH_FILES[@]}"; then
        ok "${#BASH_FILES[@]} files"
    else
        fail "shfmt found formatting drift (fix with: shfmt -i 4 -ci -w <file>)"
    fi
fi

step "zsh -n (zsh files)"
if need zsh; then
    for f in "${ZSH_FILES[@]}"; do
        if zsh -n "$f"; then
            ok "$f"
        else
            fail "$f"
        fi
    done
fi

step "stylua --check nvim/.config/nvim"
if need stylua; then
    # Not `nvim/`: stylua skips hidden directories, which would check nothing.
    if [ -z "$(find nvim/.config/nvim -name '*.lua' -print -quit)" ]; then
        fail "no Lua files found under nvim/.config/nvim"
    elif stylua --check nvim/.config/nvim; then
        ok "nvim/.config/nvim"
    else
        fail "stylua found formatting drift (fix with: stylua nvim/.config/nvim)"
    fi
fi

# True when a vendored mod differs from the merge base (committed, staged,
# unstaged or untracked), or when no base can be found (then test it).
vendored_changed() {
    local base ref
    for ref in origin/dev origin/main; do
        base=$(git merge-base HEAD "$ref" 2>/dev/null) && break
        base=""
    done
    [ -n "$base" ] || return 0
    git diff --quiet "$base" -- "$1" || return 0
    [ -z "$(git ls-files --others --exclude-standard -- "$1" | head -n 1)" ] || return 0
    return 1
}

step "claude plugin test (claude-mods/*)"
if need claude optional; then
    for dir in claude-mods/*/; do
        if [ ! -d "${dir}hooks" ]; then
            printf '  skip  %s (no hooks/)\n' "$dir"
            continue
        fi
        if [ "$dir" = "claude-mods/rabe/" ] && [ "${LINT_VENDORED:-}" != "1" ] && ! vendored_changed "$dir"; then
            printf '  skip  %s (vendored, unchanged; LINT_VENDORED=1 tests it)\n' "$dir"
            SKIPPED=$((SKIPPED + 1))
            continue
        fi
        if claude plugin test "$dir" >/dev/null 2>&1; then
            ok "$dir"
        else
            fail "$dir (rerun: claude plugin test $dir)"
        fi
    done
fi

printf '\n'
if [ "$FAILED" -gt 0 ]; then
    printf 'lint: %d failure(s), %d skipped\n' "$FAILED" "$SKIPPED"
    exit 1
fi
printf 'lint: all checks passed (%d skipped)\n' "$SKIPPED"
