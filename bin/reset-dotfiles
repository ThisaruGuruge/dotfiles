#!/bin/bash
# Dotfiles Reset/Clean Script
# Removes every bestow-managed symlink (the main package set into $HOME and the
# bin package into ~/bin), then offers, one prompt each and defaulting to "no":
#   - removing the ~/.dotfiles_backup* directories init.sh created
#   - uninstalling the packages/*.brewfile packages (the core Brewfile stays)
#   - uninstalling Homebrew entirely
#
# Usage: reset-dotfiles
#        reset-dotfiles -h | --help

case "${1:-}" in
    -h | --help)
        sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p;}' "$0"
        exit 0
        ;;
esac

set -e # Exit on any error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Unicode symbols
CHECK="✅"
CROSS="❌"
WARNING="⚠️"
INFO="ℹ️"

# Logging functions
log_success() {
    echo -e "  ${GREEN}${CHECK}  $1${NC}"
}

log_warning() {
    echo -e "  ${YELLOW}${WARNING}  $1${NC}"
}

log_info() {
    echo -e "  ${CYAN}${INFO}  $1${NC}"
}

log_error() {
    echo -e "  ${RED}${CROSS}  $1${NC}"
}

log_step() {
    echo ""
    echo -e "${BLUE}==>${NC} ${PURPLE}$1${NC}"
}

# Confirmation prompt
confirm() {
    local prompt="$1"
    local default="${2:-n}"

    if [[ "$default" == "y" ]]; then
        prompt="$prompt [Y/n] "
    else
        prompt="$prompt [y/N] "
    fi

    read -r -p "$prompt" response
    response=${response:-$default}

    [[ "$response" =~ ^[Yy]$ ]]
}

# Installed Homebrew formulae and casks, read once: `brew list <name>` starts a
# Ruby process per call, which adds up over a few dozen packages. Names are
# matched whole-line and also by their last path component, so a tap-qualified
# entry ("user/tap/name") still finds the installed "name".
BREW_FORMULAE=""
BREW_CASKS=""
BREW_LISTED=false

load_brew_lists() {
    [ "$BREW_LISTED" = true ] && return 0
    BREW_FORMULAE=$(brew list -1 --formula 2>/dev/null || true)
    BREW_CASKS=$(brew list -1 --cask 2>/dev/null || true)
    BREW_LISTED=true
}

brew_formula_installed() {
    [ -n "$1" ] || return 1
    load_brew_lists
    grep -qxF -e "$1" -e "${1##*/}" <<<"$BREW_FORMULAE"
}

brew_cask_installed() {
    [ -n "$1" ] || return 1
    load_brew_lists
    grep -qxF -e "$1" -e "${1##*/}" <<<"$BREW_CASKS"
}

# Get the dotfiles directory (resolve a symlinked invocation such as ~/bin/reset-dotfiles)
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
DOTFILES_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
cd "$DOTFILES_DIR"

echo ""
echo -e "${BLUE}╔════════════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║${NC}  ${PURPLE}Dotfiles Reset/Clean Script${NC}                            ${BLUE}║${NC}"
echo -e "${BLUE}╚════════════════════════════════════════════════════════════╝${NC}"
echo ""

log_warning "This script will remove bestow-managed symlinks from your home directory"
echo ""

if ! command -v bestow >/dev/null 2>&1; then
    log_error "bestow is not installed; nothing to check"
    exit 1
fi

# Check what will be removed
log_step "Checking current bestow setup"

# Preview what bestow would remove. Sets LINKS to the links, one per line.
# The output and exit status are captured so that a bestow failure is shown
# instead of looking like an empty list.
preview_links() {
    local out
    if ! out=$(bestow unstow "$@" --dry-run -v 2>&1); then
        log_error "bestow could not preview the removal; nothing was changed. Its output:"
        echo "$out" >&2
        return 1
    fi
    LINKS=$(grep -E "REMOVE:" <<<"$out" | sed -E 's/.*REMOVE: //' || true)
}

ALL_LINKS=""
preview_links || exit 1
ALL_LINKS="$LINKS"
# bin/ symlinks into ~/bin, not $HOME, so it needs a separate destination
if [ -d "$DOTFILES_DIR/bin" ]; then
    preview_links bin -d "$HOME/bin" || exit 1
    if [ -n "$LINKS" ]; then
        ALL_LINKS="${ALL_LINKS:+$ALL_LINKS
}$LINKS"
    fi
fi

echo ""
LINK_COUNT=0
if [ -n "$ALL_LINKS" ]; then
    LINK_COUNT=$(printf '%s\n' "$ALL_LINKS" | wc -l | tr -d ' ')
    log_warning "The following symlinks will be removed:"
    echo ""
    printf '%s\n' "$ALL_LINKS" | sed 's/^/  - /'
    echo ""
    log_info "$LINK_COUNT links will be removed"
    echo ""
    if ! confirm "Do you want to proceed with removing these symlinks?" "n"; then
        log_info "Aborted by user"
        exit 0
    fi
else
    log_info "No bestow-managed symlinks found: nothing to remove"
fi

if [ "$LINK_COUNT" -gt 0 ]; then
    # Remove bestow symlinks
    log_step "Removing bestow symlinks"

    if bestow unstow 2>&1; then
        log_success "Removed all bestow-managed symlinks"
    else
        log_error "Failed to remove some symlinks"
    fi

    if [ -d "$DOTFILES_DIR/bin" ]; then
        if bestow unstow bin -d "$HOME/bin" 2>&1; then
            log_success "Removed bin package symlinks from ~/bin"
        else
            log_error "Failed to remove bin package symlinks"
        fi
    fi
fi

# Additional cleanup
log_step "Additional cleanup"

# init.sh writes ~/.dotfiles_backup_<timestamp>; older runs used ~/.dotfiles_backup
shopt -s nullglob
BACKUP_DIRS=("$HOME"/.dotfiles_backup*/)
shopt -u nullglob
for backup_dir in "${BACKUP_DIRS[@]}"; do
    backup_dir="${backup_dir%/}"
    log_info "Found backup directory at $backup_dir"
    find "$backup_dir" -mindepth 1 -maxdepth 1 | sed 's/^/      /'
    if confirm "Do you want to remove $backup_dir?" "n"; then
        rm -rf -- "$backup_dir"
        log_success "Removed $backup_dir"
    else
        log_info "Keeping $backup_dir"
        log_info "To restore its files: $(printf 'cp -a %q/. ~/' "$backup_dir")"
    fi
done

# Optional: Remove installed packages
echo ""
log_info "Only the optional packages/*.brewfile entries are removed; the core Brewfile packages stay installed"
if confirm "Do you want to uninstall packages that were installed via init.sh?" "n"; then
    log_step "Uninstalling packages"

    # Uninstall packages from brewfiles
    if [ -d "$DOTFILES_DIR/packages" ]; then
        for brewfile in "$DOTFILES_DIR/packages"/*.brewfile; do
            if [ -f "$brewfile" ]; then
                log_info "Processing $(basename "$brewfile")"
                # Extract package names and uninstall
                while IFS= read -r line; do
                    # Skip comments and empty lines
                    [[ "$line" =~ ^#.*$ ]] && continue
                    [[ -z "$line" ]] && continue

                    if [[ "$line" =~ ^brew[[:space:]]\"(.*)\" ]]; then
                        package="${BASH_REMATCH[1]}"
                        if brew_formula_installed "$package"; then
                            log_info "Uninstalling $package"
                            brew uninstall "$package" 2>/dev/null || log_warning "Could not uninstall $package"
                        fi
                    elif [[ "$line" =~ ^cask[[:space:]]\"(.*)\" ]]; then
                        package="${BASH_REMATCH[1]}"
                        if brew_cask_installed "$package"; then
                            log_info "Uninstalling cask $package"
                            brew uninstall --cask "$package" 2>/dev/null || log_warning "Could not uninstall $package"
                        fi
                    fi
                done <"$brewfile"
            fi
        done
        log_success "Package uninstallation complete"
    fi
fi

# Optional: Uninstall Homebrew
echo ""
if confirm "Do you want to uninstall Homebrew entirely?" "n"; then
    log_warning "This will remove Homebrew and ALL installed packages"
    if confirm "Are you absolutely sure?" "n"; then
        log_info "Uninstalling Homebrew..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/uninstall.sh)"
        log_success "Homebrew uninstalled"
    fi
fi

echo ""
echo -e "${GREEN}╔════════════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║${NC}  ${GREEN}Reset complete!${NC}                                           ${GREEN}║${NC}"
echo -e "${GREEN}╚════════════════════════════════════════════════════════════╝${NC}"
echo ""
log_info "Your dotfiles symlinks have been removed"
log_info "To reinstall, run: ./init.sh"
echo ""
