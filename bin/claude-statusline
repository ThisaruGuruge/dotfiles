#!/bin/sh
# Claude Code status line, shared by both accounts (Catppuccin Mocha).
# claude/.claude-{personal,enterprise}/statusline-command.sh exec this with their own label and colour.
#
# Usage: claude-statusline --label NAME --color 'R;G;B' [--cost nonzero|always] < status-json
#
# Segments: ● ACCOUNT · RC · vim mode · dir · git branch+counts · model · cost · tokens
# Context bar, rate limits and per-turn stats live in the statusbar mod (claude-mods/statusbar).
#
# One jq reads the status JSON and one `git status --porcelain=v2 --branch` gives the branch and
# the staged/unstaged/untracked counts (a detached HEAD adds one `git rev-parse --short`).
#
# RC (Remote Control): `◉ RC` while this session has a Remote Control bridge, `○ RC off` otherwise.
# Claude Code puts nothing about the bridge in the status JSON, so this reads two undocumented
# internals that a future Claude Code version could change or drop:
#   1. CLAUDE_CODE_BRIDGE_SESSION_ID in Claude's environment, which this script inherits;
#   2. failing that, a `bridgeSessionId` key in ${CLAUDE_CONFIG_DIR:-~/.claude}/sessions/<claude pid>.json
#      (the pid is $PPID: Claude runs `bash statusline-command.sh`, which execs this script).
# It means "a bridge handle exists": it cannot tell waiting from attached from reconnecting, and an
# outbound-only mirror session shows RC too. Settings refresh the line every 15 s (refreshInterval)
# because toggling /remote-control raises none of the usual refresh events.
#
# CLAUDE_STATUSLINE_COLUMNS, when set, is the terminal width (tests use it; a status line may have
# no terminal to ask).

label=""
account_rgb="205;214;244"
cost_mode="nonzero"
while [ $# -gt 0 ]; do
    case "$1" in
        --label)
            label=$2
            shift 2
            ;;
        --color)
            account_rgb=$2
            shift 2
            ;;
        --cost)
            cost_mode=$2
            shift 2
            ;;
        *) shift ;;
    esac
done

# ── Status JSON: one jq, every field shell-quoted ───────────────────────────
cwd=""
vim_mode=""
model=""
cost=""
tokens_used=""
tokens_max=""
ESC=""
TAB=""
SEP=""
eval "$(jq -r '
    @sh "cwd=\(.workspace.current_dir // .cwd // "")",
    @sh "vim_mode=\(.vim.mode // "")",
    @sh "model=\(.model.display_name // "")",
    @sh "cost=\(.cost.total_cost_usd // .session.cost_usd // "")",
    @sh "tokens_used=\(.context_window.total_input_tokens // "")",
    @sh "tokens_max=\(.context_window.context_window_size // "")",
    @sh "ESC=\("\u001b")",
    @sh "TAB=\("\t")",
    @sh "SEP=\("\u001f")"
' 2>/dev/null)"
# jq hands over the control characters too (no printf subshells); fall back if it did not run
[ -n "$ESC" ] || ESC=$(printf '\033')
[ -n "$TAB" ] || TAB=$(printf '\t')
[ -n "$SEP" ] || SEP=$(printf '\037')

# ── Directory ────────────────────────────────────────────────────────────────
[ -z "$cwd" ] && cwd=$(pwd)
dir_name=${cwd%/}
dir_name=${dir_name##*/}
[ -n "$dir_name" ] || dir_name=/
[ "$cwd" = "$HOME" ] && dir_name="~"

# ── Git branch + status counts: one git status ──────────────────────────────
git_branch=""
git_staged=0
git_unstaged=0
git_untracked=0
TAB=$(printf '\t')
# --no-ahead-behind: the counts are not shown, and on a far-diverged branch they cost a walk on every refresh
# git feeds awk directly; awk prints nothing when git failed (no `# branch.head` line), which
# sends a repo without a work tree to the fallback below
IFS=$TAB read -r git_head _ git_staged git_unstaged git_untracked <<EOF
$(GIT_OPTIONAL_LOCKS=0 git -C "$cwd" status --porcelain=v2 --branch --no-ahead-behind 2>/dev/null | awk '
    /^# branch\.oid / { oid = $3 }
    /^# branch\.head / { head = substr($0, 15); seen = 1 }
    /^[12u] / {
        if (substr($2, 1, 1) ~ /[MADRC]/) s++
        if (substr($2, 2, 1) ~ /[MD]/) u++
    }
    /^\? / { n++ }
    END { if (seen) printf "%s\t%s\t%d\t%d\t%d\n", head, oid, s, u, n }')
EOF
if [ -n "$git_head" ]; then
    if [ "$git_head" != "(detached)" ]; then
        git_branch="$git_head"
    elif short=$(GIT_OPTIONAL_LOCKS=0 git -C "$cwd" rev-parse --short HEAD 2>/dev/null); then
        git_branch="@$short"
    fi
else
    git_staged=0
    git_unstaged=0
    git_untracked=0
    if git_out=$(GIT_OPTIONAL_LOCKS=0 git -C "$cwd" symbolic-ref --short HEAD 2>/dev/null); then
        # Inside a repo but not a work tree (.git itself, a bare repo): branch only, as before
        git_branch="$git_out"
    fi
fi

# ── Remote Control bridge ────────────────────────────────────────────────────
rc_on=0
if [ -n "${CLAUDE_CODE_BRIDGE_SESSION_ID:-}" ]; then
    rc_on=1
else
    session_file="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions/$PPID.json"
    # grep instead of a second jq: a bridgeSessionId key whose value is not null
    if [ -f "$session_file" ] && grep -Eq '"bridgeSessionId"[[:space:]]*:[[:space:]]*[^n[:space:]]' "$session_file" 2>/dev/null; then
        rc_on=1
    fi
fi

# ── Colors (Catppuccin Mocha palette, ANSI true-color) ───────────────────────
RESET="${ESC}[0m"
DIR_BG="${ESC}[48;2;49;50;68m"
DIR_FG="${ESC}[38;2;205;214;244m"
GIT_FG="${ESC}[38;2;166;227;161m"
MODEL_FG="${ESC}[38;2;137;220;235m"
GREEN_FG="${ESC}[38;2;166;227;161m"
YELLOW_FG="${ESC}[38;2;249;226;175m"
DIM="${ESC}[2m"
TOKENS_FG="${ESC}[38;2;147;153;178m"
COST_FG="${ESC}[38;2;245;194;231m"
BLUE_FG="${ESC}[38;2;137;180;250m"
ACCOUNT_FG="${ESC}[38;2;${account_rgb}m"

# ── Assemble output ───────────────────────────────────────────────────────────
# Each segment is added with its visible width, then the segments are spread across the
# terminal: the gap is whatever width is left over, kept between 3 and 8 columns.
SEP=$(printf '\037')
segs=""
count=0
total=0
add() {
    segs="${segs}${2}${SEP}"
    count=$((count + 1))
    total=$((total + $1))
}

# Account indicator
add $((${#label} + 2)) "${ACCOUNT_FG}● ${label}${RESET}"

# Remote Control
if [ "$rc_on" -eq 1 ]; then
    add 4 "${GREEN_FG}◉ RC${RESET}"
else
    add 8 "${TOKENS_FG}○ RC off${RESET}"
fi

# Vim mode segment
if [ -n "$vim_mode" ]; then
    case "$vim_mode" in
        NORMAL)
            VIM_FG="$BLUE_FG"
            vim_label="NORMAL"
            ;;
        INSERT)
            VIM_FG="$GREEN_FG"
            vim_label="INSERT"
            ;;
        "VISUAL LINE")
            VIM_FG="$YELLOW_FG"
            vim_label="V-LINE"
            ;;
        VISUAL)
            VIM_FG="$YELLOW_FG"
            vim_label="VISUAL"
            ;;
        *)
            VIM_FG="$TOKENS_FG"
            vim_label="$vim_mode"
            ;;
    esac
    add ${#vim_label} "${VIM_FG}${vim_label}${RESET}"
fi

# Directory + git segment: branch and staged/unstaged/untracked counts
dir_seg="${DIR_BG}${DIR_FG} ${dir_name} ${RESET}"
dir_len=$((${#dir_name} + 2))
if [ -n "$git_branch" ]; then
    dir_seg="${dir_seg} ${GIT_FG}${git_branch}${RESET}"
    dir_len=$((dir_len + 1 + ${#git_branch}))
    if [ "$git_staged" -gt 0 ]; then
        dir_seg="${dir_seg} ${GREEN_FG}+${git_staged}${RESET}"
        dir_len=$((dir_len + 2 + ${#git_staged}))
    fi
    if [ "$git_unstaged" -gt 0 ]; then
        dir_seg="${dir_seg} ${YELLOW_FG}~${git_unstaged}${RESET}"
        dir_len=$((dir_len + 2 + ${#git_unstaged}))
    fi
    if [ "$git_untracked" -gt 0 ]; then
        dir_seg="${dir_seg} ${TOKENS_FG}?${git_untracked}${RESET}"
        dir_len=$((dir_len + 2 + ${#git_untracked}))
    fi
fi
add "$dir_len" "$dir_seg"

# Model segment
if [ -n "$model" ]; then
    add ${#model} "${DIM}${MODEL_FG}${model}${RESET}"
fi

# Session cost: `always` shows $0.00 too (company spend), `nonzero` hides it until it is non-zero
if [ "$cost_mode" = "always" ]; then
    cost_text=$(printf '$%.2f' "${cost:-0}")
    add ${#cost_text} "${COST_FG}${cost_text}${RESET}"
elif [ -n "$cost" ] && [ "$cost" != "0" ] && [ "$cost" != "0.0" ]; then
    cost_text=$(printf '$%.2f' "$cost")
    add ${#cost_text} "${COST_FG}${cost_text}${RESET}"
fi

# Absolute token count
if [ -n "$tokens_used" ] && [ -n "$tokens_max" ]; then
    tokens_text="$((tokens_used / 1000))k/$((tokens_max / 1000))k"
    add ${#tokens_text} "${TOKENS_FG}${tokens_text}${RESET}"
fi

# Terminal width: stty needs a controlling terminal, which a status line may not have
cols=${CLAUDE_STATUSLINE_COLUMNS:-}
case "$cols" in
    '' | *[!0-9]*)
        cols=$({ stty size </dev/tty; } 2>/dev/null)
        cols=${cols#* }
        ;;
esac
case "$cols" in
    '' | *[!0-9]*) cols=${COLUMNS:-0} ;;
esac
case "$cols" in
    '' | *[!0-9]*) cols=0 ;;
esac
gap=5
if [ "$cols" -gt 0 ] && [ "$count" -gt 1 ]; then
    gap=$(((cols - 4 - total) / (count - 1)))
    [ "$gap" -lt 3 ] && gap=3
    [ "$gap" -gt 8 ] && gap=8
fi

# Two no-break spaces start the line (plain spaces get trimmed), then the segments
printf '\302\240\302\240'
n=0
OLD_IFS=$IFS
IFS=$SEP
for seg in $segs; do
    n=$((n + 1))
    [ "$n" -gt 1 ] && printf '%*s' "$gap" ''
    printf '%s' "$seg"
done
IFS=$OLD_IFS
printf '\n'
