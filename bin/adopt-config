#!/bin/bash
# Adopt an existing ~/.config/<app-name> directory into the dotfiles repo.
# It moves the directory to <app-name>/.config/<app-name> in the repo, adds a
# .bestowignore if the package has none, and stows the package so the files are
# symlinked back. It refuses an app that is already managed.
#
# Usage: ./bin/adopt-config <app-name>
#        ./bin/adopt-config -h | --help

case "${1:-}" in
    -h | --help)
        sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p;}' "$0"
        exit 0
        ;;
esac

set -e

APP_NAME="${1:-}"
# Resolve a symlinked invocation (e.g. ~/bin/adopt-config) to the real repo
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
DOTFILES_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
CONFIG_SOURCE="$HOME/.config/$APP_NAME"
CONFIG_DEST="$DOTFILES_DIR/$APP_NAME/.config/$APP_NAME"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

if [ -z "$APP_NAME" ]; then
    echo -e "${RED}Error: Please provide an application name${NC}"
    echo "Usage: $0 <app-name>"
    echo ""
    echo "Example: $0 fish"
    exit 1
fi

if [ ! -d "$CONFIG_SOURCE" ]; then
    echo -e "${RED}Error: $CONFIG_SOURCE does not exist${NC}"
    exit 1
fi

# bestow links per file and never links a directory, so "already managed" means
# the repo already has this package's config, or the live directory already
# holds links that resolve into the repo.
if [ -L "$CONFIG_SOURCE" ]; then
    echo -e "${YELLOW}$APP_NAME is already a symlink, skipping${NC}"
    readlink "$CONFIG_SOURCE"
    exit 0
fi

if [ -e "$CONFIG_DEST" ]; then
    echo -e "${RED}Error: $CONFIG_DEST already exists in the repo; $APP_NAME looks already managed${NC}"
    echo "Nothing was moved. Remove or merge it by hand if you really mean to re-adopt."
    exit 1
fi

DOTFILES_REAL="$(cd -P "$DOTFILES_DIR" && pwd -P)"
while IFS= read -r link; do
    target="$(readlink -f "$link" 2>/dev/null || true)"
    case "$target" in
        "$DOTFILES_REAL"/*)
            echo -e "${YELLOW}$APP_NAME is already managed: $link -> $target${NC}"
            echo "Nothing was moved."
            exit 1
            ;;
    esac
done < <(find "$CONFIG_SOURCE" -type l 2>/dev/null)

echo -e "${GREEN}Adopting $APP_NAME into dotfiles...${NC}"
echo ""

# Show size
SIZE=$(du -sh "$CONFIG_SOURCE" | awk '{print $1}')
echo "Size: $SIZE"
echo ""

# Check if it contains sensitive data. List file names only (-l): printing the
# matching lines would put the secrets themselves on screen and in scrollback.
hits="$(grep -r -l -I -i -E "(token|password|key|secret|credential)" "$CONFIG_SOURCE" 2>/dev/null | head -10 || true)"
if [ -n "$hits" ]; then
    echo "$hits"
    echo ""
    echo -e "${YELLOW}⚠️  Warning: the files above may contain sensitive data!${NC}"
    echo -e "${YELLOW}Make sure to add appropriate .bestowignore and .gitignore entries${NC}"
    echo ""
fi

# Ask for confirmation
read -p "Do you want to adopt this config? (y/N): " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Cancelled"
    exit 0
fi

# Move to dotfiles
echo "Moving $CONFIG_SOURCE to $CONFIG_DEST..."
mkdir -p "$(dirname "$CONFIG_DEST")"
mv "$CONFIG_SOURCE" "$CONFIG_DEST"

# Create .bestowignore if needed (must live at the package root, i.e.
# $APP_NAME/.bestowignore, not nested inside .config/$APP_NAME — bestow
# silently ignores per-package ignore files placed anywhere else)
PACKAGE_ROOT="$DOTFILES_DIR/$APP_NAME"
if [ ! -f "$PACKAGE_ROOT/.bestowignore" ]; then
    echo "Creating .bestowignore..."
    cat >"$PACKAGE_ROOT/.bestowignore" <<'EOF'
# Ignore sensitive and generated files
*.log
*.cache
**/cache/**
**/Cache/**
*.token
*.key
credentials*
secrets*
EOF
fi

# Stow to create the symlink
cd "$DOTFILES_DIR"
bestow stow "$APP_NAME"

echo -e "${GREEN}✓ Successfully adopted $APP_NAME${NC}"
echo -e "${GREEN}✓ Symlink created: $CONFIG_SOURCE -> $CONFIG_DEST${NC}"
echo ""

# Files git ignores were still moved into the repo's working tree. They won't
# be committed by `git add`, but `git add -f`, `git stash -u` or copying the
# checkout would take them along — keep secrets out of the package instead.
IGNORED_FILES=$(git -C "$DOTFILES_DIR" ls-files --others --ignored --exclude-standard -- "$APP_NAME" 2>/dev/null)
if [ -n "$IGNORED_FILES" ]; then
    echo -e "${YELLOW}⚠️  These git-ignored files now live inside the repo working tree:${NC}"
    while IFS= read -r ignored_file; do
        echo "    $ignored_file"
    done <<<"$IGNORED_FILES"
    echo -e "${YELLOW}If any hold secrets, move them back out of $PACKAGE_ROOT and keep them in .bestowignore${NC}"
    echo ""
fi
echo "Next steps:"
echo "1. Review $PACKAGE_ROOT/.bestowignore"
echo "2. Git commit the new config"
echo "3. Test that the application still works"
