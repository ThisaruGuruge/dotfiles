# Environment Variables Template
# Secrets go in ~/.env (sops-encrypted). Run `edit_secrets` and copy the keys
# you need from here; never create zsh/.env in the repo.

# GitHub Configuration
export packageUser='YOUR_GITHUB_USERNAME'
export packagePAT='YOUR_GITHUB_PERSONAL_ACCESS_TOKEN'

# Add any other environment variables you need below
# export CUSTOM_VAR='value'
