{
  "env": {
    "BASH_OUTPUT_MAX_LENGTH": "150000",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/dotfiles/claude-mods/statusbar:~/dotfiles/claude-mods/blast-radius:~/dotfiles/claude-mods/redact:~/dotfiles/claude-mods/agents:~/dotfiles/claude-mods/rabe:~/dotfiles/claude-mods/session-wrapped:~/dotfiles/claude-mods/conventions"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/thisaru/.claude-enterprise/statusline-command.sh",
    "refreshInterval": 15
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/claude-tmux-state\" working >/dev/null 2>&1 || true",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/claude-tmux-state\" waiting >/dev/null 2>&1 || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/claude-notify\" attention >/dev/null 2>&1 || true",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/claude-tmux-state\" done >/dev/null 2>&1 || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/claude-notify\" done >/dev/null 2>&1 || true",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/claude-tmux-state\" done >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/claude-notify\" subagent >/dev/null 2>&1 || true",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/claude-notify\" attention >/dev/null 2>&1 || true",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/claude-tmux-state\" resume >/dev/null 2>&1 || true",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/claude-tmux-state\" clear >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "stable",
  "theme": "dark",
  "editorMode": "vim",
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: (unknown — origin/HEAD unset; not queryable via gh for this repo)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo and its remote(s) only (no additional orgs configured) — as scoped by the Trusted repo and Repository visibility entries above",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited — e.g. matches `prod-db`, not `producer`)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: The git repository the agent started in — no remotes configured, and no tracked files, so visibility and remote scoping cannot be determined; treat as private/local until a remote is added",
      "**Org-specific CLIs**: None configured"
    ]
  },
  "hideVimModeIndicator": true
}
