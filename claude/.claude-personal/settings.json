{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_OUTPUT_MAX_LENGTH": "150000",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/dotfiles/claude-mods/statusbar:~/dotfiles/claude-mods/blast-radius:~/dotfiles/claude-mods/redact:~/dotfiles/claude-mods/agents:~/dotfiles/claude-mods/rabe:~/dotfiles/claude-mods/session-wrapped"
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/thisaru/.claude-personal/statusline-command.sh",
    "refreshInterval": 5
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/claude-tmux-state\" working >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/claude-tmux-state\" waiting >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/claude-tmux-state\" done >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/claude-tmux-state\" clear >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "allium@juxt-plugins": true
  },
  "autoCompactWindow": 500000,
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim",
  "verbose": true,
  "agentPushNotifEnabled": true,
  "hideVimModeIndicator": false,
  "model": "sonnet"
}
