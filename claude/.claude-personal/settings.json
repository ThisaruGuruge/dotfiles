{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_OUTPUT_MAX_LENGTH": "150000",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/dotfiles/claude-mods/statusbar:~/dotfiles/claude-mods/blast-radius:~/dotfiles/claude-mods/redact:~/dotfiles/claude-mods/mission-control:~/dotfiles/claude-mods/session-wrapped"
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/thisaru/.claude-personal/statusline-command.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "allium@juxt-plugins": true
  },
  "autoCompactWindow": 500000,
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim",
  "verbose": true,
  "agentPushNotifEnabled": true,
  "hideVimModeIndicator": false,
  "autocompact_percentage_override": 75,
  "model": "sonnet"
}
