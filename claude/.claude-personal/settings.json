{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_OUTPUT_MAX_LENGTH": "150000"
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/thisaru/.claude-personal/statusline-command.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "allium@juxt-plugins": true
  },
  "autoCompactWindow": 300000,
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim",
  "verbose": true,
  "hideVimModeIndicator": true,
  "autocompact_percentage_override": 75,
  "model": "opus"
}
