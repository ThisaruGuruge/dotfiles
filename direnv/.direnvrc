# Global direnv configuration
# This file provides global functions and settings for direnv.
#
# Don't redefine direnv stdlib functions here (dotenv, dotenv_if_exists,
# layout node/python/go, ...): a replacement applies to every .envrc. In
# particular the stdlib `dotenv` parses KEY=value files without running them,
# whereas sourcing a .env as shell code would execute anything in it (e.g.
# API=$(curl ... | sh)) on cd, with no `direnv allow` for the .env itself.

# Load a Node.js version through nvm (Homebrew install or ~/.nvm)
use_nvm() {
    local node_version=${1:-default}
    local nvm_sh

    for nvm_sh in "${NVM_DIR:-$HOME/.nvm}/nvm.sh" "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/nvm/nvm.sh"; do
        if [[ -s "$nvm_sh" ]]; then
            # shellcheck disable=SC1090 # nvm.sh location varies by install
            source "$nvm_sh"
            nvm use "$node_version"
            return
        fi
    done
    log_error "nvm not found"
}

# Load common project dependencies: `use project_env` in an .envrc
use_project_env() {
    # Load .env if present (stdlib parser; never executed as shell code)
    dotenv_if_exists

    # Detect and set up the project type with the stdlib layouts
    if [[ -f "package.json" ]]; then
        layout node
    elif [[ -f "requirements.txt" ]] || [[ -f "pyproject.toml" ]]; then
        layout python3
    fi
}
