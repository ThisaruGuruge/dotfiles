# Environment and secrets
.env
.env.*
!.env.example
.gitconfig.local
# Per-machine sops config (names this machine's age recipient); init.sh writes
# ~/.sops.yaml from bash/.sops.yaml.example
bash/.sops.yaml

# Secrets the per-package .bestowignore files keep out of $HOME must stay out
# of git too: a stray copy inside a package (e.g. from adopt-config) would
# otherwise be one `git add -A` away from a public repo
gh/**/hosts.yml
atuin/**/key
atuin/**/session
atuin/**/history.db*
*.token
*.key
*.pem
credentials*
git/.config/git/work.gitconfig
git/.config/git/personal.gitconfig
git/.config/git/allowed_signers

# IDE and editor
.vscode

# AI agent context (local only)
.claude
.claudeignore
CLAUDE.md

# macOS
.DS_Store

# Analysis and reports
analysis
*audit-report*

# Override global gitignore - we WANT to track .config in this repo
!/.config
!/.config/**

# Neovim
*.swp
*.swo
*~
.netrwhist
.nvim-state/
.local_state/
lazy-lock.json

# SSH keys (config is tracked, keys are NOT)
ssh/.ssh/id_*
ssh/.ssh/known_hosts
ssh/.ssh/authorized_keys

# Session Artifacts
dotfiles_analysis_report.md
commits-backup-*.txt
