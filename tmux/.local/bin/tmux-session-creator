#!/usr/bin/env bash
# TMux Session Creator - Create a new named session from a popup
# Prompts for session name, then uses fzf to pick a directory

# Prompt for session name
printf "\033[1;34m Session Name:\033[0m "
read -r session_name

# Exit if empty
if [[ -z "$session_name" ]]; then
    exit 0
fi

# Sanitize session name: dots and colons are not allowed in tmux session names, a "$"
# would be read as a session id, and spaces are awkward in targets. Slashes stay, so
# "work/api" here matches the parent-qualified names the sessionizer (prefix + f) makes.
session_name=$(printf '%s\n' "$session_name" | tr '.:$ ' '____')

# Check if session already exists
if tmux has-session -t="$session_name" 2>/dev/null; then
    printf "\033[1;33m Session '%s' already exists. Switching...\033[0m\n" "$session_name"
    sleep 0.5
    tmux switch-client -t "$session_name"
    exit 0
fi

# Pick directory with fzf (search from home, show common project dirs first)
session_dir=$(
    {
        # Common starting points
        echo "$HOME"
        echo "$HOME/dotfiles"
        # Project directories (2 levels deep)
        [[ -d "$HOME/Projects" ]] && find "$HOME/Projects" -mindepth 1 -maxdepth 2 -type d 2>/dev/null
    } | awk '!seen[$0]++' | fzf \
        --height=100% \
        --reverse \
        --prompt="  Directory > " \
        --header="Select starting directory (Esc = use HOME)" \
        --color="header:#89b4fa,prompt:#a6e3a1,pointer:#f38ba8,hl:#f9e2af,hl+:#f9e2af"
)

# Default to home if nothing selected
if [[ -z "$session_dir" ]]; then
    session_dir="$HOME"
fi

# Create the new session (Long Runs / CLAUDE / NVim windows; SESSIONIZER_LAYOUT=bare
# for a single shell window). Falls back to a plain session if the helper is missing.
layout_helper="$(cd "$(dirname "$0")" && pwd)/tmux-session-layout"
if [[ -x "$layout_helper" ]]; then
    "$layout_helper" "$session_name" "$session_dir"
    status=$?
else
    msg="tmux-session-layout is missing next to $(basename "$0"): opening a bare session. Run: bestow stow tmux"
    printf '\033[1;33m %s\033[0m\n' "$msg" >&2
    tmux display-message "$msg" 2>/dev/null
    sleep 1.5
    tmux new-session -ds "$session_name" -c "$session_dir"
    status=$?
fi
if ((status != 0)); then
    printf '\033[1;31m Could not create session '"'%s'"' (exit %d)\033[0m\n' "$session_name" "$status" >&2
    sleep 2
    exit 1
fi
printf "\033[1;32m Created session '%s' in %s\033[0m\n" "$session_name" "$session_dir"
sleep 0.4
# Switch must be the last command — popup exits immediately after, matching
# the pattern used by the 's' switcher. Staying alive after switch-client
# causes tmux to snap the client back to the session that owned the popup.
tmux switch-client -t "$session_name"
