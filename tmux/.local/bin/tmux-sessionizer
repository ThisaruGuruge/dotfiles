#!/usr/bin/env bash
# TMux Sessionizer (prefix + f) - pick a project or create one, then open a named session.
#
#   Enter   open the highlighted project (switches if it already has a session)
#   Ctrl-n  new project: pick a group, then give a name (git init) or a git URL (clone)
#   Esc     cancel
#
# "~" starts a session in $HOME for work that is not tied to a project. A project is any
# directory under $PROJECTS_DIR with a .git entry (see tmux-project-list); nothing inside one
# is listed. The session name is asked after the directory, defaulting to the shortest path
# tail that is free (api, wso2/api, work/wso2/api, ...); Enter accepts it.

PROJECTS_DIR="${PROJECTS_DIR:-$HOME/projects}"
LIST="$(dirname "$0")/tmux-project-list"
NEW_PROJECT="+ New project…"
NEW_GROUP="+ New group…"
HOME_ENTRY="~"

# Pick a directory. Prints its absolute path, or nothing when cancelled.
get_selected() {
    local out key choice
    out=$({
        printf '%s\n' "$NEW_PROJECT" "$HOME_ENTRY"
        "$LIST" projects | sed "s|^$PROJECTS_DIR/||"
    } | fzf --height=40% --reverse --border --prompt="Project > " --expect=ctrl-n \
        --header="Enter open · Ctrl-n new project · Esc cancel") || return 0
    key=$(printf '%s\n' "$out" | sed -n 1p)
    choice=$(printf '%s\n' "$out" | sed -n 2p)
    if [[ "$key" == "ctrl-n" || "$choice" == "$NEW_PROJECT" ]]; then
        new_project
    elif [[ "$choice" == "$HOME_ENTRY" ]]; then
        printf '%s' "$HOME"
    elif [[ -n "$choice" ]]; then
        printf '%s' "$PROJECTS_DIR/$choice"
    fi
}

# Create (or clone) a project and print its path. Pick the group it goes in, then give a name
# (git init) or a git URL / alias such as wso2:repo (git clone). Prompts and git output go to
# the popup's terminal, only the final path goes to stdout.
new_project() {
    local choice rel group input name target
    choice=$({
        printf '%s\n' "$NEW_GROUP"
        "$LIST" groups | sed "s|^$PROJECTS_DIR/||"
    } | fzf --height=40% --reverse --border --prompt="Group > " \
        --header="Where should the new project live?") || return 0
    [[ -z "$choice" ]] && return 0

    if [[ "$choice" == "$NEW_GROUP" ]]; then
        read -r -p "New group under ${PROJECTS_DIR/#$HOME/\~}/ (e.g. work/wso2): " rel </dev/tty >&2
        rel="${rel#/}"
        rel="${rel%/}"
        case "$rel" in
            '' | *..* | *[[:space:]]*) warn "Not a valid group: '$rel'" && return 0 ;;
        esac
        group="$PROJECTS_DIR/$rel"
    else
        group="$PROJECTS_DIR/$choice"
    fi

    read -r -p "Project name or git URL: " input </dev/tty >&2
    input="${input#"${input%%[![:space:]]*}"}"
    input="${input%"${input##*[![:space:]]}"}"
    [[ -z "$input" ]] && return 0

    if [[ "$input" == */* || "$input" == *:* ]]; then
        name="${input%/}"
        name="${name%.git}"
        name="${name##*[/:]}"
    else
        name="$input"
    fi
    if [[ -z "$name" || "$name" == .* || ! "$name" =~ ^[A-Za-z0-9._-]+$ ]]; then
        warn "Not a valid project name: '$name'"
        return 0
    fi
    target="$group/$name"

    if [[ -e "$target" ]]; then
        warn "$name already exists in ${group#"$PROJECTS_DIR"/}; opening it"
    elif [[ "$name" != "$input" ]]; then
        mkdir -p "$group"
        if ! git clone "$input" "$target" >&2; then
            warn "Clone failed"
            return 0
        fi
    else
        mkdir -p "$target"
        if ! git init -q "$target" >&2; then
            warn "Could not create $target"
            return 0
        fi
    fi
    printf '%s' "$target"
}

# Session names cannot contain "." or ":" (tmux replaces them), and a leading "$" would be
# read as a session id by tmux's target parser, so none of the three survive.
sanitize() {
    printf '%s' "$1" | tr '.:$' '___'
}

# True when session $1 already holds directory $2: its recorded start directory is $2, or
# one of its panes is in $2 or below it. Sessions started in $HOME or restored
# by tmux-resurrect record a different start directory but are still "the" session for
# the project they are working in, so judging by the recorded directory alone would
# create a duplicate.
session_holds_dir() {
    tmux list-panes -a -F $'#{session_name}\t#{session_path}\t#{pane_current_path}' 2>/dev/null |
        awk -F'\t' -v n="$1" -v d="$2" '
            $1 == n {
                sub(/\/$/, "", $2)
                sub(/\/$/, "", $3)
                if ($2 == d || $3 == d || index($3, d "/") == 1) { found = 1; exit }
            }
            END { exit !found }'
}

# Pick the session name for a directory: the shortest tail of its path under $PROJECTS_DIR
# that no other project's session already uses (repo, then group/repo, then org/group/repo,
# ...), numbered as a last resort. A session counts as owning a name for another project
# only when it holds nothing in this directory.
pick_session_name() {
    local dir="${1%/}"
    local rel parts k n i candidate
    if [[ "$dir" == "$HOME" ]]; then
        rel="home"
    elif [[ "$dir" == "$PROJECTS_DIR"/* ]]; then
        rel="${dir#"$PROJECTS_DIR"/}"
    else
        rel="$(basename "$dir")"
    fi
    IFS=/ read -r -a parts <<<"$rel"
    n=${#parts[@]}

    for ((k = 1; k <= n; k++)); do
        candidate=""
        for ((i = n - k; i < n; i++)); do
            candidate="${candidate:+$candidate/}${parts[i]}"
        done
        candidate=$(sanitize "$candidate")
        if ! tmux has-session -t="$candidate" 2>/dev/null || session_holds_dir "$candidate" "$dir"; then
            printf '%s' "$candidate"
            return
        fi
    done

    n=2
    while :; do
        candidate="$(sanitize "$rel")-$n"
        if ! tmux has-session -t="$candidate" 2>/dev/null || session_holds_dir "$candidate" "$dir"; then
            printf '%s' "$candidate"
            return
        fi
        n=$((n + 1))
    done
}

# Say it where the user will see it: the popup's terminal, and tmux's status line (the
# popup is gone by the time the message would otherwise be read).
warn() {
    printf '\033[1;33m %s\033[0m\n' "$1" >&2
    [[ -n "${TMUX:-}" ]] && tmux display-message "$1" 2>/dev/null
    sleep 1.5
}

# The session that already holds directory $1 (a pane in it or below it, or started there), if
# any. $HOME is matched exactly, because every session has a pane somewhere below it.
session_for_dir() {
    tmux list-panes -a -F $'#{session_name}\t#{session_path}\t#{pane_current_path}' 2>/dev/null |
        awk -F'\t' -v d="$1" -v home="$HOME" '
            {
                sub(/\/$/, "", $2)
                sub(/\/$/, "", $3)
                if ($2 == d || $3 == d || (d != home && index($3, d "/") == 1)) { print $1; exit }
            }'
}

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(get_selected)
fi
[[ -z "$selected" ]] && exit 0

# A session already works in this directory: just go there
selected_name=""
[[ "$selected" != "$HOME" ]] && selected_name=$(session_for_dir "${selected%/}")

if [[ -z "$selected_name" ]]; then
    default_name=$(pick_session_name "$selected")
    read -r -e -p "Session name [$default_name]: " selected_name </dev/tty
    selected_name="${selected_name:-$default_name}"
    # Same rules as pick_session_name: "." and ":" are not allowed in names, "$" would be read
    # as a session id, and spaces are awkward in targets. Slashes stay.
    selected_name=$(printf '%s' "$selected_name" | tr '.:$ ' '____')
fi

# If the session doesn't exist, create it (detached): one plain shell window in the directory
if ! tmux has-session -t="$selected_name" 2>/dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected" || {
        warn "Could not create session '$selected_name'"
        exit 1
    }
fi

# Switch must be the last command: the popup exits right after, and staying alive after
# switch-client makes tmux snap the client back to the session that owned the popup.
if [[ -z "$TMUX" ]]; then
    tmux attach-session -t="$selected_name"
else
    tmux switch-client -t="$selected_name"
fi
