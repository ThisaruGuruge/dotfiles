#!/usr/bin/env bash
# TMux Command Palette - fuzzy search and execute tmux keybindings
# Reads entries from tmux-palette-entries, displays via fzf, executes selection
#
# Entry format (see tmux-palette-entries): category | key | description | tmux-command
# The key and description may contain the placeholder {pipe}, shown as a literal "|"
# (a bare "|" would be taken as a field separator).

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENTRIES_FILE="$SCRIPT_DIR/tmux-palette-entries"

if [[ ! -f "$ENTRIES_FILE" ]]; then
    echo "Error: palette entries file not found at $ENTRIES_FILE"
    exit 1
fi

# Parse entries into "<display><TAB><tmux-command>" lines. fzf shows only the first
# tab-delimited field, so "|" is free to appear in the display text.
# Comments become dimmed section headers (searchable, but selecting one does nothing).
selection=$(grep -v '^[[:space:]]*$' "$ENTRIES_FILE" | awk -F '|' '
    /^#/ {
        # The file-level documentation at the top is not a section: skip it
        if ($0 ~ /^# *---/) started = 1
        if (!started) next
        gsub(/^# *-* */, "", $0)
        printf "\033[2m── %s\033[0m\t\n", $0
        next
    }
    {
        n = split($0, f, "|")
        # The command is everything after the third "|" (it may contain "|" itself)
        cmd = f[4]
        for (i = 5; i <= n; i++) cmd = cmd "|" f[i]
        for (i = 1; i <= 3; i++) {
            gsub(/^[ \t]+|[ \t]+$/, "", f[i])
            gsub(/\{pipe\}/, "|", f[i])
        }
        gsub(/^[ \t]+|[ \t]+$/, "", cmd)
        printf "\033[36m%-12s\033[0m \033[33m%-18s\033[0m %s\t%s\n", f[1], f[2], f[3], cmd
    }
' | fzf --ansi \
    --delimiter=$'\t' \
    --with-nth=1 \
    --header="  TMux Command Palette  (Enter to execute, Esc to cancel)" \
    --prompt="  " \
    --reverse \
    --no-sort \
    --border=none \
    --margin=1,2 \
    --color="header:#89b4fa,prompt:#a6e3a1,pointer:#f38ba8,hl:#f9e2af,hl+:#f9e2af")

# Exit if nothing selected
[[ -z "$selection" ]] && exit 0

# The tmux command is everything after the first tab
tmux_cmd="${selection#*$'\t'}"

# Skip section headers and display-only entries
[[ -z "$tmux_cmd" || "$tmux_cmd" == "noop" ]] && exit 0

# Run the command through tmux's own parser (source-file) so quoting, "\;" separators
# and "~" behave exactly as they would in .tmux.conf. It is deferred until this popup
# has closed: a popup cannot open another popup, and commands such as display-popup
# and detach-client need the client back once the palette exits.
cmd_file=$(umask 077 && mktemp "${TMPDIR:-/tmp}/tmux-palette.XXXXXX") || exit 1
printf '%s\n' "$tmux_cmd" >"$cmd_file"
tmux run-shell -b "sleep 0.2; tmux source-file '$cmd_file'; rm -f '$cmd_file'"
