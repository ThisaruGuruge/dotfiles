Include /Users/thisaru/.config/colima/ssh_config

# GitHub, over port 443: some networks block outbound port 22. ssh.github.com:443 serves the
# same keys as github.com, so HostKeyAlias reuses the github.com entry in known_hosts.
Host github.com
    HostName ssh.github.com
    Port 443
    User git
    HostKeyAlias github.com
    AddKeysToAgent yes
    UseKeychain yes
    IdentityFile ~/.ssh/id_ed25519
