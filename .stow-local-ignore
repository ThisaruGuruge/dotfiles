# Stow ignore patterns for the dotfiles root
# Applied when stowing the dotfiles directory itself as a package

# Git internals
^\.git$
^\.gitignore$
^\.gitattributes$
^\.github$

# Generated state files
^\.nvim-state$

# macOS metadata
\.DS_Store

# Backup files
.*~
\.bak$
\.swp$

# Documentation and repo metadata
^README\.md$
^CHANGELOG\.md$
^CONTRIBUTING\.md$
^SECURITY\.md$
^CLAUDE\.md$
^LICENSE$
^VERSION$

# Scripts not meant to be symlinked
^init\.sh$
^cleanup\.sh$

# Directories not meant to be symlinked
^packages$
^docs$

# Misc repo files
^Brewfile$
^claude-audit-report$
